# syntax=docker/dockerfile:1
# check=error=true

# The compose stack's backup container (midrolo-backup in compose.yml): bin/backup with pg_dump and psql from the
# same PostgreSQL 16 as the database (the app image's client is Debian's 15, which can't dump a 16 server), and
# aws-cli for Cloudflare R2. Built on the server with the rest of the stack.
FROM docker.io/library/postgres:16

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y awscli ca-certificates && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

COPY bin/backup /usr/local/bin/backup

# Where bin/backup records a failed run (BACKUP_STATE_DIR in compose.yml). The midrolo-backup-state volume mounts here
# and starts with this directory's owner, so the flag outlives restarts and redeploys.
RUN mkdir -p /var/lib/midrolo-backup && chown postgres:postgres /var/lib/midrolo-backup

# Not root: the postgres image's own user, which writes only there and in /tmp.
USER postgres
CMD ["backup", "daily"]

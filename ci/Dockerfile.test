# syntax=docker/dockerfile:1
# Test runner for bin/remote-rspec (tagged midrolo-ci:test on ioflood). Holds only system packages: the source is
# mounted at /app and the gems live in the midrolo-ci-bundle volume at /bundle, so a Gemfile change needs no rebuild.
# bin/remote-rspec rebuilds the image when this file's hash changes (or with --rebuild).

# Keep in step with .ruby-version. The slim image is Debian bookworm.
ARG RUBY_VERSION=3.4.1
FROM docker.io/library/ruby:${RUBY_VERSION}-slim

# build-essential, pkg-config, libpq-dev, libyaml-dev: native gems (pg, psych, bootsnap, msgpack, ...).
# libvips42: ruby-vips (image_processing) loads it at run time through ffi.
# postgresql-client: pg_isready, while the per-run database starts.
# chromium + fonts: Cuprite's headless browser for system specs.
# tzdata: tzinfo reads /usr/share/zoneinfo on Linux.
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential pkg-config git curl ca-certificates tzdata \
      libpq-dev libyaml-dev libvips42 postgresql-client \
      chromium fonts-liberation fonts-noto-color-emoji && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

# Ferrum (under Cuprite) starts the browser from BROWSER_PATH. Gems install into the cached volume, from the
# lockfile as committed.
ENV BROWSER_PATH=/usr/bin/chromium \
    BUNDLE_PATH=/bundle \
    BUNDLE_FROZEN=true \
    BUNDLE_JOBS=8 \
    BUNDLE_RETRY=3 \
    RAILS_ENV=test

WORKDIR /app

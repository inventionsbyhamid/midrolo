# Copy to .env and fill in. Every variable the app reads is listed, blank, with what it does.
# The uncommented ones are required: production stops at boot naming any that's blank (lib/required_env.rb), and
# compose refuses to start the backup container without R2_BACKUP_BUCKET and its own token.
# The rest are optional and commented out: uncomment one to set it. Leave unused ones commented: a variable set to
# nothing is an empty string, which is not the same as unset for the ones with a default.

# --- Core ---
# The site's public address, for links in email: https://midrolo.com (development: localhost on PORT).
APP_URL=
# Signs sessions and cookies; make one with bin/rails secret. Or set RAILS_MASTER_KEY instead.
SECRET_KEY_BASE=
# Instead of SECRET_KEY_BASE: the key to config/credentials.yml.enc, which holds one.
# RAILS_MASTER_KEY=
# Password for the database's midrolo user; compose creates the database with it. Or set DATABASE_URL instead.
MIDROLO_DATABASE_PASSWORD=
# Instead of MIDROLO_DATABASE_PASSWORD: a full postgres:// URL, for a database outside the compose stack.
# DATABASE_URL=
# The database host. compose.yml sets midrolo-db for the app containers; unset elsewhere means the local socket.
# DB_HOST=
# Log level: unset means info.
# RAILS_LOG_LEVEL=
# Threads per process, and so database connections. compose.yml sets each container's; unset means 3 Puma threads.
# RAILS_MAX_THREADS=
# Puma worker processes: unset means 1.
# WEB_CONCURRENCY=
# Processes for the default queue's worker (config/queue.yml): unset means 1.
# JOB_CONCURRENCY=
# Runs Solid Queue inside Puma when set. Keep it unset in the compose stack, where the jobs container runs it.
# SOLID_QUEUE_IN_PUMA=

# --- Email ---
# Resend API key, for every email.
RESEND_API_KEY=
# The From address: unset means "Midrolo <hello@midrolo.com>".
# MAIL_FROM=
# Emails a day and a month, kept under Resend's free tier (100 and 3,000): unset means 90 and 2800 (R143).
# Welcome and runs-resumed mail stop at 60% of the daily limit, so codes and report mail keep the rest.
# MAIL_DAILY_LIMIT=
# MAIL_MONTHLY_LIMIT=

# --- Auth and admin ---
# Google OAuth credentials (Devise + OmniAuth). Unset: sign in with Google fails (development offers a dev sign in).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# HTTP basic auth for /admin and /admin/jobs, on top of a signed-in user with users.admin set. Unset: /admin is a 404.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# Where error mail goes (comma separated). Unset: every admin account's address.
# ADMIN_EMAIL=

# --- Qloo taste data ---
# Hackathon API key. Outside production, unset means demo data; production has none, so it's required there.
QLOO_API_KEY=
# The Qloo base URL: unset means https://hackathon.api.qloo.com.
# QLOO_BASE_URL=
# Qloo calls a minute: unset means 30.
# QLOO_MAX_PER_MINUTE=
# Qloo calls a day: unset means 100 (the admin settings page overrides it).
# QLOO_DAILY_CALL_LIMIT=
# The free and promo share of the daily Qloo calls, 0 to 1: unset means 0.4 (admin settings override it).
# QLOO_FREE_SHARE=
# What one Qloo call costs in USD, for the margins page: unset means not set (admin settings override it).
# QLOO_COST_PER_CALL_USD=

# --- Podcast Index ---
# Directory API credentials. Outside production, unset means demo data; production has none, so they're required.
PODCAST_INDEX_KEY=
PODCAST_INDEX_SECRET=

# --- LLM ---
# openrouter, anthropic or fake: unset means openrouter. Fake is also used when the provider's key is unset outside
# production.
# LLM_PROVIDER=
# OpenRouter API key for the agent and pitches. Unset in production: runs fail until it's set.
# OPENROUTER_API_KEY=
# Keys for other providers, if LLM_PROVIDER names one: ANTHROPIC_API_KEY for anthropic, and so on.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# Models for the agent run and for pitch drafting, as the provider names them: unset means
# deepseek/deepseek-v4.1-flash (OpenRouter's id). Each needs a price in config/llm_pricing.yml.
# LLM_AGENT_MODEL=
# LLM_PITCH_MODEL=
# Daily LLM spend cap in USD: unset means 5 (admin settings override it).
# LLM_DAILY_BUDGET_USD=

# --- Promo and judging ---
# Promo accounts get Pro through this date (2026-11-06 at launch): unset means no promo (admin settings override it).
# PROMO_PRO_UNTIL=
# Total USD for promo agent reports: unset means 10 (admin settings override it).
# PROMO_BUDGET_USD=
# USD held back for judges: unset means 5 (admin settings override it).
# JUDGE_RESERVE_USD=
# The code a judge redeems for Pro with extra reports. Unset: no code works.
# JUDGE_CODE=
# true pauses every new run: unset means runs go ahead (admin settings override it).
# RUNS_PAUSED=
# Why runs are paused, shown with the pause: unset means no reason given.
# RUNS_PAUSED_REASON=

# --- Billing ---
# waitlist, test or live: unset means waitlist.
# BILLING_MODE=
# Dodo Payments API key, for checkout and the customer portal. Unset: no checkout.
# DODO_API_KEY=
# test_mode or live_mode: unset means test_mode.
# DODO_ENVIRONMENT=
# Standard Webhooks signing secret for /webhooks/dodo. Unset: webhooks wait (503) until it's set.
# DODO_WEBHOOK_SECRET=
# Dodo product ids behind the plans.yml price keys.
# DODO_PRODUCT_CREATOR_MONTHLY=
# DODO_PRODUCT_CREATOR_YEARLY=
# DODO_PRODUCT_PRO_MONTHLY=
# DODO_PRODUCT_PRO_YEARLY=
# DODO_PRODUCT_SPRINT=

# --- Maps ---
# MapLibre style for the heatmap: unset means https://tiles.openfreemap.org/styles/positron. The Content Security
# Policy allows this URL's host; a style that loads tiles from further hosts needs them added there.
# MAP_STYLE_URL=

# --- Cloudflare R2 (uploads and backups) ---
# The Cloudflare account id the buckets belong to.
R2_ACCOUNT_ID=
# The app's R2 API token, with Object Read and Write on the uploads bucket only: its key id, then its secret.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The bucket for uploads (kit images).
R2_BUCKET=
# The bucket for the nightly database backups (bin/backup, run by the compose stack's midrolo-backup container).
R2_BACKUP_BUCKET=
# The backup container's own R2 API token, with Object Read and Write on the backup bucket only, so the app's token
# can't reach the backups: its key id, then its secret.
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=

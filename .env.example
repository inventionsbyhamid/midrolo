# Copy to .env and fill in. Every variable the app reads is listed here.

# --- Core ---
# Public hostname used in links and emails.
APP_HOST=midrolo.com
# Host port the web container binds to (compose).
HOST_PORT=3410
# Log to stdout in containers.
RAILS_LOG_TO_STDOUT=1
# Production database password.
MIDROLO_DATABASE_PASSWORD=

# --- Auth ---
# Google OAuth credentials (Devise + OmniAuth).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# HTTP basic auth for /admin and /admin/jobs, on top of a signed-in user with users.admin set. With either one
# blank, /admin is a 404.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Qloo taste data ---
# Hackathon API key; Fake adapter is used when blank outside production.
QLOO_API_KEY=
# Override the Qloo base URL.
QLOO_BASE_URL=https://hackathon.api.qloo.com

# --- Podcast Index ---
# Directory API credentials; Fake adapter is used when blank outside production.
PODCAST_INDEX_KEY=
PODCAST_INDEX_SECRET=

# --- LLM ---
# anthropic | fake. Fake is also used when ANTHROPIC_API_KEY is blank outside production.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional alternative provider keys.
OPENAI_API_KEY=
GEMINI_API_KEY=
# Models for the agent run and for pitch drafting.
LLM_AGENT_MODEL=claude-opus-5-5
LLM_PITCH_MODEL=claude-opus-5-5
# Daily LLM spend cap in USD.
LLM_DAILY_BUDGET_USD=5

# --- Promo and judging ---
# Promo accounts get Pro until this date.
PROMO_PRO_UNTIL=2026-11-06
# Total USD budget for promo agent reports.
PROMO_BUDGET_USD=10
# USD held back for judges.
JUDGE_RESERVE_USD=5
# Code a judge redeems to get Pro with extra reports.
JUDGE_CODE=
# Set to true to pause all agent runs (a Setting row overrides this).
RUNS_PAUSED=false

# --- Billing ---
# waitlist (default) | test | live
BILLING_MODE=waitlist
DODO_API_KEY=
# Standard Webhooks signing secret.
DODO_WEBHOOK_SECRET=
# Dodo product ids behind the plans.yml price_keys.
DODO_PRODUCT_CREATOR_MONTHLY=
DODO_PRODUCT_CREATOR_YEARLY=
DODO_PRODUCT_PRO_MONTHLY=
DODO_PRODUCT_PRO_YEARLY=
DODO_PRODUCT_SPRINT=

# --- Email ---
# Resend API key for transactional email.
RESEND_API_KEY=

# --- Maps ---
# MapLibre style URL for the geo heatmap.
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# --- Cloudflare R2 (file storage and backups) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket for uploads (kit images).
R2_BUCKET=
# Bucket for nightly database backups.
R2_BACKUP_BUCKET=

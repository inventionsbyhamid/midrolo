#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  # This script is a way to set up or update your development environment automatically.
  # This script is idempotent, so that you can run it at any time and get an expectable outcome.
  # Add necessary setup steps to this file.
  #
  #   bin/setup                 install, prepare the database, seed the demo data, then start bin/dev
  #   bin/setup --skip-server   the same without starting bin/dev (the dev container and compose.demo.yml use this)
  #   bin/setup --reset         drop and rebuild the development database first

  puts "== Installing dependencies =="
  system("bundle check") || system!("bundle install")

  # puts "\n== Copying sample files =="
  # unless File.exist?("config/database.yml")
  #   FileUtils.cp "config/database.yml.sample", "config/database.yml"
  # end

  puts "\n== Preparing database =="
  system! "bin/rails db:prepare"
  system! "bin/rails db:reset" if ARGV.include?("--reset")

  # The demo catalog, an admin to sign in as and the demo show (lib/tasks/demo.rake, DemoSeed). The task itself skips
  # unless it's development without Qloo or Podcast Index keys; another RAILS_ENV isn't even booted.
  development = (ENV["RAILS_ENV"] || ENV["RACK_ENV"] || "development") == "development"
  seeded = false
  if development
    puts "\n== Seeding demo data =="
    IO.popen(%w[bin/rails demo:seed], err: %i[child out]) do |io|
      io.each_line do |line|
        print line
        seeded ||= line.start_with?("demo:seed: demo-admin@midrolo.test is an admin")
      end
    end
    abort "bin/rails demo:seed failed" unless $?.success?
  end

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  if development
    port = ENV["PORT"].to_s.strip.empty? ? "3100" : ENV["PORT"].strip
    puts <<~NEXT

      == Next steps ==
      #{ARGV.include?("--skip-server") ? "Run bin/dev, then open" : "Starting bin/dev; open"} http://localhost:#{port}
      #{seeded ? "Sign in with the Dev sign in card as demo-admin@midrolo.test to be an admin (/admin)." : "Sign in with the Dev sign in card (shown while GOOGLE_CLIENT_ID is unset)."}
      Then try "Find podcasts your customers love", or request a spot on the Midrolo Demo Show.
      Mail opens at http://localhost:#{port}/letter_opener
    NEXT
  end

  unless ARGV.include?("--skip-server")
    puts "\n== Starting development server =="
    STDOUT.flush # flush the output before exec(2) so that it displays
    exec "bin/dev"
  end
end

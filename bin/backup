#!/usr/bin/env bash
# Database backups to Cloudflare R2 (docs/deploy.md). Runs in the compose stack's midrolo-backup container, which has
# pg_dump and psql for PostgreSQL 16 and aws-cli. The database comes from the PG* variables (PGHOST, PGUSER,
# PGPASSWORD, PGDATABASE); R2 from R2_ACCOUNT_ID, R2_BACKUP_BUCKET and a token of its own, scoped to that bucket:
# BACKUP_R2_ACCESS_KEY_ID and BACKUP_R2_SECRET_ACCESS_KEY.
#
#   backup                          dump the database, gzip it and stream it to R2, then delete backups over 14 days old
#   backup daily                    do that every day at 03:00 UTC (the container's command)
#   backup list                     the backups in R2, oldest first
#   backup restore NAME [DATABASE]  load backup NAME (from list) into DATABASE (default PGDATABASE), which must exist
#                                   and be empty: the download is checked whole first, then loaded in one transaction
#   backup health                   fails, saying when, from a failed backup until a later one succeeds (the health check)
set -euo pipefail
export TZ=UTC

KEEP_DAYS=14
PREFIX=midrolo/
FAILED="${BACKUP_STATE_DIR:-/tmp}/midrolo-backup-failed"

need_r2() {
  : "${R2_ACCOUNT_ID:?set R2_ACCOUNT_ID}" "${R2_BACKUP_BUCKET:?set R2_BACKUP_BUCKET}"
  : "${BACKUP_R2_ACCESS_KEY_ID:?set BACKUP_R2_ACCESS_KEY_ID}" "${BACKUP_R2_SECRET_ACCESS_KEY:?set BACKUP_R2_SECRET_ACCESS_KEY}"
}

# aws-cli against R2. R2 rejects the checksums newer aws-cli versions add by default, and has no instance metadata.
r2() {
  AWS_ACCESS_KEY_ID=$BACKUP_R2_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY=$BACKUP_R2_SECRET_ACCESS_KEY AWS_DEFAULT_REGION=auto \
    AWS_EC2_METADATA_DISABLED=true AWS_REQUEST_CHECKSUM_CALCULATION=when_required \
    AWS_RESPONSE_CHECKSUM_VALIDATION=when_required \
    aws --endpoint-url "https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com" "$@"
}

# Records how this run ended, for the health check: a failure stays recorded until a later backup succeeds.
record_outcome() {
  local status=$? when
  if ((status == 0)); then
    rm -f "$FAILED"
  else
    printf -v when '%(%Y-%m-%d %H:%M UTC)T' "$EPOCHSECONDS"
    echo "the backup of ${when} failed (exit ${status})" > "$FAILED"
  fi
}

# A failed dump or upload leaves no backup behind under a real backup's name, and deletes nothing.
backup_once() {
  local name url
  trap record_outcome EXIT
  need_r2
  printf -v name 'midrolo-%(%Y-%m-%dT%H%M%SZ)T.sql.gz' "$EPOCHSECONDS"
  url="s3://${R2_BACKUP_BUCKET}/${PREFIX}${name}"
  if ! pg_dump --no-owner --no-privileges | gzip | r2 s3 cp - "$url"; then
    r2 s3 rm "$url" >/dev/null 2>&1 || true
    echo "backup: failed, nothing uploaded and nothing deleted" >&2
    exit 1
  fi
  echo "backup: uploaded ${name}"
  prune
}

# Deletes only this script's own backups (midrolo-<timestamp>.sql.gz) from before the cutoff.
prune() {
  local cutoff key name
  printf -v cutoff 'midrolo-%(%Y-%m-%dT%H%M%SZ)T' $((EPOCHSECONDS - KEEP_DAYS * 86400))
  r2 s3api list-objects-v2 --bucket "$R2_BACKUP_BUCKET" --prefix "$PREFIX" --query 'Contents[].Key' --output text |
    tr '\t' '\n' | while read -r key; do
      name=${key#"$PREFIX"}
      if [[ $name =~ ^midrolo-[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{6}Z\.sql\.gz$ && $name < $cutoff ]]; then
        r2 s3 rm "s3://${R2_BACKUP_BUCKET}/${key}"
      fi
    done
}

# Sleeps until 03:00 UTC, backs up, and again the next day. Each run is its own process, so set -e holds inside it,
# and each records its own outcome.
daily() {
  local now next
  while true; do
    now=$EPOCHSECONDS
    next=$((now - now % 86400 + 3 * 3600))
    ((next > now)) || next=$((next + 86400))
    sleep $((next - now))
    "${BASH_SOURCE[0]}" || echo "backup: failed, trying again tomorrow" >&2
  done
}

# Downloads the whole backup, checks it is a complete gzip file holding a complete dump (pg_dump's last lines say
# so), and only then loads it in one transaction that stops at the first error. So a failed restore loads nothing.
restore() {
  local name=${1:?usage: backup restore NAME [DATABASE]} database=${2:-${PGDATABASE:?set PGDATABASE}}
  need_r2
  name=${name#"$PREFIX"}
  restore_file=$(mktemp "${TMPDIR:-/tmp}/midrolo-restore.XXXXXX")
  trap 'rm -f "$restore_file"' EXIT
  r2 s3 cp "s3://${R2_BACKUP_BUCKET}/${PREFIX}${name}" "$restore_file" --only-show-errors
  gzip -t "$restore_file"
  if ! gunzip -c "$restore_file" | tail -n 5 | grep -q "PostgreSQL database dump complete"; then
    echo "backup: ${name} is not a complete dump, so nothing was loaded" >&2
    exit 1
  fi
  gunzip -c "$restore_file" |
    psql --quiet --no-psqlrc --set ON_ERROR_STOP=1 --single-transaction --output /dev/null --dbname "$database"
  echo "backup: restored ${name} into ${database}"
}

health() {
  [[ -e $FAILED ]] || return 0
  cat "$FAILED"
  return 1
}

case "${1:-}" in
  "") backup_once ;;
  daily) daily ;;
  list) need_r2 && r2 s3 ls "s3://${R2_BACKUP_BUCKET}/${PREFIX}" ;;
  restore) shift && restore "$@" ;;
  health) health ;;
  *) echo "usage: backup [daily | list | restore NAME [DATABASE] | health]" >&2 && exit 64 ;;
esac

<%# locals: (pitch:) -%>
<%#
  One pitch: a skeleton while it's written, the pack once done, or why it failed with a way to try again (a pitch
  stuck in the queue counts as failed). The target Pitch#broadcast_result replaces, so it renders in jobs too: no
  current_user, and the owner is read through the match.
%>
<% match = pitch.sponsor_match %>
<div id="<%= dom_id(pitch) %>" class="pitch">
  <% if pitch.in_flight? %>
    <p class="text-[0.9375rem] text-ink-soft">Writing your pitch to <%= match.name %>. This usually takes under a minute.</p>
    <div class="pitch-email p-4"><%= render "components/skeleton", lines: 7, label: "Writing your pitch" %></div>
  <% elsif pitch.done? %>
    <% email_id = dom_id(pitch, :email) %>
    <section class="pitch-section" aria-labelledby="<%= email_id %>">
      <h3 id="<%= email_id %>" class="pitch-label">Email</h3>
      <div class="pitch-email">
        <div class="pitch-subject" data-controller="clipboard">
          <span class="pitch-subject-label">Subject</span>
          <span class="pitch-subject-text" data-pitch-subject data-clipboard-target="source"><%= pitch.subject %></span>
          <button type="button" class="link pitch-subject-copy" data-action="clipboard#copy">
            <span data-clipboard-target="label" aria-live="polite">Copy subject</span>
          </button>
        </div>
        <div data-controller="clipboard">
          <div class="pitch-text" data-pitch-body data-clipboard-target="source"><%= pitch.body %></div>
          <div class="pitch-email-footer">
            <p class="pitch-meta"><%= pitch_word_count(pitch) %></p>
            <div class="pitch-buttons">
              <button type="button" class="btn btn-primary btn-md" data-action="clipboard#copy">
                <svg viewBox="0 0 16 16" class="size-4" aria-hidden="true"><path d="M5.5 5.5V3.75c0-.69.56-1.25 1.25-1.25h5.5c.69 0 1.25.56 1.25 1.25v5.5c0 .69-.56 1.25-1.25 1.25H10.5M3.75 5.5h5.5c.69 0 1.25.56 1.25 1.25v5.5c0 .69-.56 1.25-1.25 1.25h-5.5c-.69 0-1.25-.56-1.25-1.25v-5.5c0-.69.56-1.25 1.25-1.25Z" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
                <span data-clipboard-target="label" aria-live="polite">Copy email</span>
              </button>
              <%= link_to gmail_compose_url(pitch), class: "btn btn-secondary btn-md", target: "_blank", rel: "noopener" do %>
                Open in Gmail
                <svg viewBox="0 0 16 16" class="size-3.5" aria-hidden="true"><path d="M6 3h7v7M13 3 4 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span class="sr-only">(opens in a new tab)</span>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </section>

    <% angles_id = dom_id(pitch, :angles) %>
    <section class="pitch-section" aria-labelledby="<%= angles_id %>">
      <h3 id="<%= angles_id %>" class="pitch-label">Ad-read angles</h3>
      <ol class="pitch-angles" data-pitch-angles>
        <% pitch.angles.each do |angle| %>
          <li><%= angle %></li>
        <% end %>
      </ol>
    </section>

    <div class="pitch-pair">
      <% offer_id = dom_id(pitch, :offer) %>
      <section class="pitch-section" aria-labelledby="<%= offer_id %>">
        <h3 id="<%= offer_id %>" class="pitch-label">Suggested offer</h3>
        <p class="pitch-offer" data-pitch-offer><%= pitch.offer %></p>
        <p class="pitch-meta mt-1.5">Priced from your rate card.</p>
      </section>

      <% contact_id = dom_id(pitch, :contact) %>
      <section class="pitch-section" aria-labelledby="<%= contact_id %>" data-pitch-contact>
        <h3 id="<%= contact_id %>" class="pitch-label">Who to contact</h3>
        <p class="font-semibold"><%= pitch.contact_role %></p>
        <% if (url = safe_external_url(match.website)) %>
          <p class="mt-1 text-sm">
            <%= link_to url, class: "link inline-flex items-center gap-1", target: "_blank", rel: "noopener noreferrer" do %>
              <%= display_host(url) %>
              <svg viewBox="0 0 16 16" class="size-3.5" aria-hidden="true"><path d="M6 3h7v7M13 3 4 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span class="sr-only">(opens in a new tab)</span>
            <% end %>
          </p>
        <% end %>
      </section>
    </div>

    <% follow_up_id = dom_id(pitch, :follow_up) %>
    <section class="pitch-section" aria-labelledby="<%= follow_up_id %>" data-controller="clipboard">
      <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
        <h3 id="<%= follow_up_id %>" class="pitch-label">Follow-up for day 7</h3>
        <button type="button" class="link text-sm font-semibold" data-action="clipboard#copy">
          <span data-clipboard-target="label" aria-live="polite">Copy follow-up</span>
        </button>
      </div>
      <div class="pitch-text pitch-text-quiet" data-pitch-follow-up data-clipboard-target="source"><%= pitch.follow_up %></div>
    </section>

    <div class="pitch-footer">
      <%= button_to sponsor_match_pitch_path(match), params: { regenerate: 1 }, class: "btn btn-ghost btn-md", form_class: "contents",
            aria: { describedby: dom_id(pitch, :regenerate_hint) } do %>
        <svg viewBox="0 0 16 16" class="size-4" aria-hidden="true"><path d="M13 8a5 5 0 1 1-1.5-3.57M13 2.5v2.75h-2.75" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Regenerate
      <% end %>
      <%= render "pitches/mark_pitched", sponsor_match: match %>
      <p id="<%= dom_id(pitch, :regenerate_hint) %>" class="pitch-meta w-full">Regenerate writes a new version and uses one pitch.</p>
    </div>
  <% else %>
    <div class="pitch-failed" role="alert">
      <p><%= pitch.error_message.presence || Pitch::FAILURE_MESSAGE %></p>
    </div>
    <%= button_to "Try again", sponsor_match_pitch_path(match), params: { regenerate: 1 }, class: "btn btn-primary btn-md self-start" %>
  <% end %>
</div>

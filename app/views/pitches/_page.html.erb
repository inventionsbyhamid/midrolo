<%# locals: (sponsor_match:, pitch:, refusal: nil) -%>
<%# The pitch pack as a page, for a browser without JavaScript (the dialog's content, under a heading). %>
<% content_for :title, "Pitch for #{sponsor_match.name}" %>
<div class="mx-auto flex max-w-2xl flex-col gap-6">
  <p class="text-sm">
    <%= link_to match_card_path(sponsor_match), class: "link" do %><span aria-hidden="true">← </span>Back to the report<% end %>
  </p>
  <h1 class="type-h2">Pitch for <%= sponsor_match.name %></h1>
  <div class="card p-5 sm:p-6">
    <%# The pack's sections are h3s, under the dialog's h2 title on the report page; here this heading stands in. %>
    <h2 class="sr-only">Pitch pack</h2>
    <%= render "pitches/pack", sponsor_match: sponsor_match, pitch: pitch, refusal: refusal %>
  </div>
</div>

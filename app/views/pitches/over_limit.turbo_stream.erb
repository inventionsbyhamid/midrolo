<% locals = { sponsor_match: @sponsor_match, pitch: @pitch, limit_reason: @limit_reason } %>
<% if @regenerate %>
  <%= turbo_stream.replace dom_id(@sponsor_match, :pitch_pack), partial: "pitches/pack", locals: locals %>
<% else %>
  <%= turbo_stream.update "pitch_dialog", partial: "pitches/dialog", locals: locals %>
<% end %>

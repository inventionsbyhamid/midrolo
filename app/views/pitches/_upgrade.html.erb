<%# locals: (reason:) -%>
<%# Why there's no new pitch (402), and the way to more. :plan has no pitches; :used_up has used this period's. %>
<div class="pitch-upgrade" role="status">
  <% if reason == :used_up %>
    <p class="font-semibold">You've used all your pitches for this period.</p>
    <p class="text-[0.9375rem] text-ink-soft">Upgrade for more, or write again when your pitches reset.</p>
  <% else %>
    <p class="font-semibold">Pitch packs come with the Creator and Pro plans.</p>
    <p class="text-[0.9375rem] text-ink-soft">Each one is a ready-to-send email, three ad-read angles, an offer priced from your rate card and a follow-up.</p>
  <% end %>
  <%= link_to "See plans", pricing_path, class: "btn btn-primary btn-md mt-1 self-start" %>
</div>

<%# locals: (sponsor_match:, pitch:, refusal: nil) -%>
<%#
  What the dialog (or the no-JavaScript page) shows for one match: why the plan said no (shared/_upgrade_prompt), then
  the newest pitch, or the offer to write one. Regenerate swaps this whole block. While the pitch is being written the
  block subscribes to its signed stream (Pitch#broadcast_result replaces pitches/_pitch there), and stream-catchup
  fetches its state once the subscription is up, in case it finished first.
%>
<% writing = pitch&.in_flight? %>
<div id="<%= dom_id(sponsor_match, :pitch_pack) %>" class="pitch-pack"
     <%= tag.attributes(data: { controller: "stream-catchup", stream_catchup_url_value: sponsor_match_pitch_path(sponsor_match, pitch_id: pitch.id) }) if writing %>>
  <% if refusal %>
    <%= render "shared/upgrade_prompt", prompt: refusal %>
  <% end %>
  <% if pitch %>
    <%= turbo_stream_from pitch if writing %>
    <%= render "pitches/pitch", pitch: pitch %>
  <% elsif !refusal %>
    <div class="pitch-empty">
      <p>Get an email ready to send, three ad read angles, an offer priced from your rate card and a follow up for next week.</p>
      <%= button_to "Write my pitch", sponsor_match_pitch_path(sponsor_match), params: { regenerate: 1 }, class: "btn btn-primary btn-md" %>
    </div>
  <% end %>
</div>

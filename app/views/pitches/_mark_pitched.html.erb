<%# locals: (sponsor_match:) -%>
<%#
  Moves the brand to "pitched" through the pipeline's own update (R51), so the plan gate (R45) and the superseded-copy
  rule (R48) hold here too; SponsorMatchesController#update replaces this after a save. Hidden without the pipeline
  on the plan. On an older report's copy it links to the copy that counts; past "pitched" it shows the stage.
%>
<% match = sponsor_match %>
<% if pipeline_enabled_for?(match.report.show.user) %>
  <div id="<%= dom_id(match, :mark_pitched) %>" class="mark-pitched">
    <% if (newer = newer_copy_for(match)) %>
      <%= link_to match_card_path(newer), class: "link text-sm" do %>Tracked on your latest report<span aria-hidden="true"> →</span><% end %>
    <% elsif match.suggested? || match.saved? %>
      <%= button_to "Mark as pitched", sponsor_match_path(match), method: :patch, params: { sponsor_match: { status: "pitched" } },
            class: "btn btn-secondary btn-md", form_class: "contents" %>
    <% elsif match.pitched? %>
      <span class="mark-pitched-done">
        <svg viewBox="0 0 16 16" class="size-4" aria-hidden="true"><path d="m3.5 8.5 3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Marked as pitched
      </span>
    <% else %>
      <span class="status-label">Pipeline</span>
      <%= status_badge(match.status) %>
    <% end %>
  </div>
<% end %>

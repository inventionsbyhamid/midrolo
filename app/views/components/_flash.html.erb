<% messages = flash.to_hash.slice("notice", "alert").select { |_, message| message.is_a?(String) && message.present? } %>
<% if messages.any? %>
  <div class="wrap mt-4 flex flex-col gap-2">
    <% messages.each do |type, message| %>
      <div class="flash flash-<%= type %>" role="<%= type == "alert" ? "alert" : "status" %>">
        <svg viewBox="0 0 20 20" class="mt-0.5 size-4 flex-none" aria-hidden="true">
          <% if type == "alert" %>
            <path class="fill-current" d="M10 2a8 8 0 1 0 0 16 8 8 0 0 0 0-16Zm-.9 4h1.8v5.2H9.1V6Zm.9 8.6a1.1 1.1 0 1 1 0-2.2 1.1 1.1 0 0 1 0 2.2Z"/>
          <% else %>
            <path class="fill-plum" d="M10 2a8 8 0 1 0 0 16 8 8 0 0 0 0-16Zm-1.1 11.4L5.6 10.1l1.3-1.3 2 2 4.2-4.2 1.3 1.3-5.5 5.5Z"/>
          <% end %>
        </svg>
        <p><%= message %></p>
      </div>
    <% end %>
  </div>
<% end %>

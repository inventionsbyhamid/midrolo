<%# locals: (compact: false) -%>
<%# compact is for pages that belong to the podcaster (kits, print): credits only, no Midrolo branding. %>
<footer class="<%= class_names("mt-auto", compact ? "pt-10" : "pt-20") %>">
  <div class="midroll-rule"></div>
  <div class="wrap flex flex-col gap-6 py-8 text-sm text-ink-soft md:flex-row md:items-start md:justify-between">
    <% unless compact %>
      <div class="flex flex-col gap-1">
        <%= link_to ui_logo, "/", class: "logo", aria: { label: "#{APP_NAME} home" } %>
        <p class="mt-1">Sponsor research for independent podcasts.</p>
        <p>Built for the Qloo Agentic Hackathon.</p>
      </div>
      <nav aria-label="Footer" class="flex flex-wrap gap-x-5 gap-y-1">
        <%= link_to "About", about_path, class: "link text-ink-soft" %>
        <%= link_to "Privacy", privacy_path, class: "link text-ink-soft" %>
        <%= link_to "Terms", terms_path, class: "link text-ink-soft" %>
        <%= contact_mail_to "Contact", class: "link text-ink-soft" %>
      </nav>
    <% end %>
    <p class="flex flex-wrap gap-x-5 gap-y-1">
      <a class="link text-ink-soft" href="https://podcastindex.org">Podcast data from Podcast Index</a>
      <a class="link text-ink-soft" href="https://www.qloo.com">Taste data from Qloo</a>
      <% unless compact %>
        <span>&copy; <%= Date.current.year %> <%= APP_NAME %></span>
      <% end %>
    </p>
  </div>
</footer>

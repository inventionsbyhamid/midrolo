<%# locals: (conversation:, side: :brand) -%>
<%= render "components/card", title: "The request" do %>
  <dl class="flex flex-col gap-3">
    <div>
      <dt class="text-sm text-ink-soft">Spot</dt>
      <dd class="font-semibold"><%= MediaKit::RATE_SLOTS.fetch(conversation.format.to_s, "Any spot") %></dd>
    </div>
    <div>
      <dt class="text-sm text-ink-soft">Months</dt>
      <dd class="font-semibold"><%= conversation.months.any? ? Copy.and_list(conversation.months.map { |month| inbox_month_label(month) }) : "Flexible" %></dd>
    </div>
    <div>
      <dt class="text-sm text-ink-soft">Budget</dt>
      <dd class="font-semibold"><%= inbox_budget(conversation.budget_cents) || "Not given" %></dd>
      <% if side == :podcaster && (check = inbox_rate_check(conversation)) %>
        <dd class="rate-check"><span class="text-ink-soft"><%= check[:rate] %></span><%= ui_badge check[:note], tone: check[:tone] %></dd>
      <% end %>
    </div>
    <div>
      <dt class="text-sm text-ink-soft">Sent</dt>
      <dd class="font-semibold"><%= inbox_time(conversation.created_at) %></dd>
    </div>
    <% if conversation.brand.domain.present? %>
      <div>
        <dt class="text-sm text-ink-soft">Brand website</dt>
        <dd class="font-semibold"><%= conversation.brand.domain %></dd>
        <% if side == :podcaster && conversation.brand.slug.present? && conversation.brand.sponsor_mentions_count.to_i.positive? %>
          <dd class="mt-1 text-sm"><%= link_to "Shows it has sponsored", public_brand_path(conversation.brand), class: "link" %></dd>
        <% end %>
      </div>
    <% end %>
  </dl>
<% end %>

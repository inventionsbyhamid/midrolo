<%# locals: (conversation:, side:, show_podcast: true) -%>
<%# One row of an inbox. The podcaster sees the brand (its monogram, whether it's verified, and its first words) and
    which show it asked about; the brand sees the show. %>
<% unread = conversation.unread_for?(side) %>
<li>
  <%= link_to conversation_path(conversation), class: class_names("card inbox-row", "inbox-row-unread" => unread) do %>
    <%= inbox_party_tile(conversation, side) %>
    <span class="flex min-w-0 flex-1 flex-col gap-1">
      <span class="flex flex-wrap items-center gap-2">
        <% if unread %>
          <span class="size-2.5 flex-none rounded-full bg-tally" aria-hidden="true"></span><span class="sr-only">New:</span>
        <% end %>
        <span class="<%= class_names("truncate", "font-bold" => unread, "font-semibold" => !unread) %>"><%= inbox_counterparty(conversation, side) %></span>
        <%= inbox_brand_badge(conversation) if side == :podcaster %>
      </span>
      <span class="truncate text-sm text-ink-soft">
        <% if side == :podcaster && show_podcast %>For <%= conversation.podcast.title %>: <% end %><%= inbox_request_summary(conversation).upcase_first %>
      </span>
      <% if side == :podcaster && (preview = inbox_preview(conversation)) %>
        <span class="line-clamp-1 text-sm">“<%= preview %>”</span>
      <% end %>
    </span>
    <span class="flex flex-none flex-col items-end gap-1">
      <%= inbox_status_badge(conversation) %>
      <span class="text-xs text-ink-soft"><%= inbox_time(conversation.last_message_at || conversation.created_at) %></span>
    </span>
  <% end %>
</li>

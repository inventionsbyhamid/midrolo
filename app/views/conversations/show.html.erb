<% podcast = @conversation.podcast %>
<% content_for :title, inbox_counterparty(@conversation, @side) %>
<%# The other side's changes arrive as a refresh on this thread's stream; the page morphs in place and the reply being
    typed (the focused box) keeps its text. %>
<% content_for :head, turbo_refreshes_with(method: :morph, scroll: :preserve) %>
<%= turbo_stream_from Conversations::Broadcast.thread_stream(@conversation) %>
<div class="flex flex-col gap-6">
  <p class="text-sm"><%= link_to "Back to your inbox", @side == :brand ? brand_inbox_path : inbox_path, class: "link" %></p>

  <header class="flex flex-wrap items-center gap-4">
    <%= inbox_party_tile(@conversation, @side, css: "size-16 text-xl") %>
    <div class="min-w-0 flex-1 basis-60">
      <h1 class="type-h2"><%= inbox_counterparty(@conversation, @side) %></h1>
      <%# One structure both ways (review C-4): who asked about which show. %>
      <p class="text-ink-soft">
        <%= @conversation.brand.name %>
        asked about sponsoring <%= link_to podcast.title, inbox_podcast_path(podcast), class: "link" %>
      </p>
      <p class="mt-2 flex flex-wrap gap-2">
        <%= inbox_status_badge(@conversation) %>
        <%= inbox_brand_badge(@conversation) if @side == :podcaster %>
      </p>
      <%# On a phone the request card sits below the thread, so the ask is summed up here (review IN-3). %>
      <p class="mt-3 text-sm font-semibold lg:hidden"><%= inbox_request_line(@conversation) %></p>
    </div>
  </header>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]">
    <div class="flex min-w-0 flex-col gap-4">
      <%= render "conversations/status_note", conversation: @conversation, side: @side %>
      <ol id="<%= dom_id(@conversation, :messages) %>" class="flex flex-col gap-3" aria-label="Messages">
        <%= render partial: "messages/message", collection: @messages,
              locals: { conversation: @conversation, brand_user_ids: @brand_user_ids, viewer: current_user } %>
      </ol>
      <%= render "messages/form", conversation: @conversation, side: @side, message: Message.new %>
    </div>

    <aside class="flex flex-col gap-4" aria-label="About this request">
      <%= render "conversations/details", conversation: @conversation, side: @side %>
      <%= render "conversations/actions", conversation: @conversation, side: @side, blocked: @blocked %>
    </aside>
  </div>
</div>

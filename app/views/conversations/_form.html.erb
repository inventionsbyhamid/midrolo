<%# locals: (podcast:, form:, facts:, error: nil) -%>
<%# The Request a spot form, in the podcast page's dialog (podcasts/_request) and on conversations/new. It reads only
    the podcast's columns (the page's podcast is strict_loading). %>
<% memberships = facts.viewer.memberships %>
<% membership = memberships.find { |member| member.brand.public_id == form.brand } || memberships.first %>
<%# What the show charges and when it's open (review BR-12): its published rate card turns the Spot choice into slot
    tiles with prices, its open months are marked, and spot_request_controller fills the budget from the slot and
    notes a budget under the slot's price. On a strict_loading podcast it reads the listing only when Podcast.for_page
    preloaded the owner show (and its kit); otherwise the plain form shows. %>
<% kit = podcast.published_listing if !podcast.strict_loading? || podcast.association(:owner_show).loaded? %>
<% rates = MediaKit::Content.new(kit, podcast: podcast).rates if kit %>
<% open_months = kit&.open_to_sponsors? ? Array(kit.open_months) : [] %>
<%= form_with model: form, url: conversations_path, method: :post, class: "flex flex-col gap-5",
      data: { turbo_frame: "_top", controller: "spot-request" } do |f| %>
  <%= hidden_field_tag :podcast, podcast.to_param, id: nil %>

  <% if error %>
    <div class="flash flash-alert" role="alert"><p><%= error %></p></div>
  <% end %>

  <% unless podcast.claimed? %>
    <p class="rounded-xl bg-tally-soft p-3 text-sm">
      <%= podcast.title %> hasn't claimed its <%= APP_NAME %> page yet. We hold your request and deliver it when they do.
      We never email shows that haven't joined.
    </p>
  <% end %>

  <% if memberships.size > 1 %>
    <div>
      <%= f.label :brand, "Ask as", class: "label" %>
      <%= f.select :brand, memberships.map { |member| [ member.brand.name, member.brand.public_id ] }, {}, class: "input" %>
    </div>
  <% end %>

  <% if kit&.looking_for.present? %>
    <div class="request-looking">
      <p class="text-sm font-semibold">Who <%= podcast.title %> is looking for</p>
      <p class="text-sm"><%= kit.looking_for %></p>
    </div>
  <% end %>

  <% if rates %>
    <fieldset>
      <legend class="label">Spot</legend>
      <div class="spot-slots">
        <% [ [ "preroll", "Preroll" ], [ "midroll", "Midroll" ], [ "postroll", "Postroll" ] ].each do |value, label| %>
          <% price = rates.public_send(value) %>
          <label class="spot-slot">
            <%= f.radio_button :format, value, class: "sr-only", data: { price: price, label: label, action: "spot-request#pick" } %>
            <span class="spot-slot-name"><%= label %></span>
            <span class="spot-slot-price"><%= price ? number_to_currency(price, precision: 0) : "Ask" %></span>
            <span class="spot-slot-note"><%= kit.rate_card_overrides[value].is_a?(Integer) ? "Set by the show" : "Suggested by #{APP_NAME}" %></span>
          </label>
        <% end %>
        <label class="spot-slot spot-slot-any">
          <%= f.radio_button :format, "", class: "sr-only", checked: form.format.blank?, data: { action: "spot-request#pick" } %>
          <span class="spot-slot-name">Any spot</span>
          <span class="spot-slot-note">Let the show suggest</span>
        </label>
      </div>
      <p class="hint">Per episode, in US dollars. Pick a spot to use its price as your budget.</p>
    </fieldset>
  <% else %>
    <div>
      <%= f.label :format, "Spot", class: "label" %>
      <%= f.select :format, [ [ "Any spot", "" ] ] + MediaKit::RATE_SLOTS.map { |value, label| [ label, value ] }, {}, class: "input" %>
    </div>
  <% end %>

  <fieldset>
    <legend class="label">Months</legend>
    <%= hidden_field_tag "spot_request[months][]", "", id: nil %>
    <div class="flex flex-wrap gap-2">
      <% inbox_month_options(form.months).each do |label, value| %>
        <% box_id = "spot_request_month_#{value}" %>
        <% open = open_months.include?(value) %>
        <label for="<%= box_id %>" class="<%= class_names("chip month-chip gap-2 cursor-pointer", "month-chip-open" => open, "month-chip-closed" => open_months.any? && !open) %>">
          <%= check_box_tag "spot_request[months][]", value, form.months.include?(value), id: box_id, class: "accent-plum" %>
          <span><%= label %></span>
          <% if open_months.any? %><span class="month-chip-tag"><%= open ? "Open" : "Not open" %></span><% end %>
        </label>
      <% end %>
    </div>
    <p class="hint">
      <% if open_months.any? %>
        <%= podcast.title %> is open for <%= Copy.and_list(open_months.map { |month| inbox_month_label(month) }) %>. Leave them all empty if you're flexible.
      <% else %>
        When you'd like the ad to run. Leave them all empty if you're flexible.
      <% end %>
    </p>
  </fieldset>

  <div>
    <%= f.label :budget, "Budget in US dollars", class: "label" %>
    <%= f.text_field :budget, class: "input max-w-xs", inputmode: "numeric", autocomplete: "off",
          placeholder: (rates&.midroll || 500).to_s,
          aria: { describedby: "spot_request_budget_hint spot_request_budget_note" },
          data: { spot_request_target: "budget", action: "input->spot-request#check" } %>
    <p id="spot_request_budget_hint" class="hint">Optional. What you'd spend on this show for the spot you picked.</p>
    <p id="spot_request_budget_note" class="hint font-semibold text-warning" data-spot-request-target="note" aria-live="polite" hidden></p>
  </div>

  <div>
    <%= f.label :body, "Message", class: "label" %>
    <%= f.text_area :body, rows: 6, class: "input", required: true, maxlength: Message::BODY_LIMIT,
          placeholder: "Who you are, what you'd like to promote and why this show fits." %>
  </div>

  <% if membership && !membership.verified? %>
    <p class="text-sm text-ink-soft">
      Your brand isn't verified yet, so the show sees an Unverified brand label and you can send
      <%= User::Brands::DAILY_REQUESTS[:unverified] %> requests a day. Verify a work email at your company's domain
      to send up to <%= User::Brands::DAILY_REQUESTS[:verified] %>.
    </p>
  <% end %>

  <%= f.submit "Send request", class: "btn btn-primary btn-lg self-start" %>
<% end %>

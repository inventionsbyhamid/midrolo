<%# locals: (show:) -%>
<%# A workspace's requests card (shows/show): what's new for a verified show, or how many brands are waiting for an
    unverified one to be verified. Nothing for an unverified show nobody asked about. %>
<% counts = inbox_workspace_counts(show) %>
<% if show.verified? %>
  <%= render "components/card", title: "Requests from brands", aside: link_to("Open inbox", show_inbox_path(show), class: "link") do %>
    <% if (line = workspace_requests_line(show, counts)) %>
      <div class="flex flex-wrap items-center justify-between gap-3">
        <p class="waiting-line"><%= line %></p>
        <%= ui_button "Read requests", show_inbox_path(show), variant: :secondary, size: :sm %>
      </div>
    <% else %>
      <p class="text-ink-soft">No new requests. Brands find you through your listing and ask from your page.</p>
    <% end %>
  <% end %>
<% elsif counts[:waiting].positive? %>
  <%= render "components/card", title: "Requests from brands" do %>
    <p class="waiting-line"><%= pluralize(counts[:waiting], "brand") %> asked about sponsoring this show</p>
    <p class="mt-1 text-ink-soft">Verify that it's yours to read their requests.</p>
    <%= ui_button "Verify ownership", new_show_verification_path(show), variant: :secondary, class: "mt-4" %>
  <% end %>
<% end %>

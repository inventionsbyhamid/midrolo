<%# locals: (row:) -%>
<%# A sponsor's promo codes and listener offer, as the show's notes gave them. %>
<% if row.promo_codes.any? || row.offer.present? %>
  <p class="flex flex-wrap items-center gap-2 text-sm">
    <% row.promo_codes.each do |code| %>
      <%= ui_badge "Code #{code}", tone: :accent %>
    <% end %>
    <% if row.offer.present? %>
      <span><%= row.offer.upcase_first %></span>
    <% end %>
  </p>
<% end %>

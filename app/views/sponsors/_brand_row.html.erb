<%# locals: (row:, podcast:) -%>
<%# One brand in a podcast's sponsor history (podcasts/_sponsors): when it was seen, its codes and offer, and the read itself. %>
<li class="flex flex-col gap-1 border-b border-line py-3.5">
  <h3 class="ep-title">
    <%= link_to row.brand.name, sponsors_brand_path(row.brand) %>
    <% if (domain = sponsors_domain(row.brand)) && domain != row.brand.name %>
      <span class="ml-1 text-sm font-normal text-ink-soft"><%= domain %></span>
    <% end %>
  </h3>
  <%= render "sponsors/meta", row: row %>
  <%= render "sponsors/evidence", row: row, podcast: podcast %>
</li>

<%# locals: (show:, primary: true) -%>
<%# primary: false when the workspace leads with a listing step instead, so the page has one primary button. %>
<% active = show.active_report %>
<% paused = AppSettings.runs_paused? %>
<% snapshot_class = primary ? "btn btn-primary btn-md" : "btn btn-secondary btn-md" %>
<%= render "components/card", title: "Find sponsors" do %>
  <p class="mb-4 max-w-prose text-ink-soft">Brands your listeners already love, ranked with taste data from Qloo. Start with a free Snapshot.</p>
  <% if paused %>
    <div class="mb-4"><%= render "shared/runs_paused" %></div>
  <% end %>
  <div class="flex flex-wrap gap-3">
    <% if active || paused %>
      <%= ui_button "Get my free Snapshot", type: "button", variant: (primary ? :primary : :secondary), disabled: true %>
      <%= ui_button "Run full report", type: "button", variant: :secondary, disabled: true %>
    <% else %>
      <%= button_to "Get my free Snapshot", show_reports_path(show, kind: "snapshot"), method: :post, class: snapshot_class %>
      <%= button_to "Run full report", show_reports_path(show, kind: "agent"), method: :post, class: "btn btn-secondary btn-md" %>
    <% end %>
  </div>
  <% if active %>
    <p class="mt-3 text-sm"><%= link_to "Research in progress", show_report_path(show, active), class: "link" %></p>
  <% elsif (latest = show.latest_report) %>
    <p class="mt-3 text-sm"><%= link_to "See your latest report", show_report_path(show, latest), class: "link" %></p>
  <% end %>
<% end %>

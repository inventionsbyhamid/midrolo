<%# locals: (show:) -%>
<% active = show.active_report %>
<% paused = AppSettings.runs_paused? %>
<%= render "components/card", title: "Find sponsors" do %>
  <% if paused %>
    <p class="mb-3 font-semibold" role="status">New reports are paused — we'll email you when they're back</p>
  <% end %>
  <div class="flex flex-wrap gap-3">
    <% if active || paused %>
      <%= ui_button "Get my free Snapshot", type: "button", disabled: true %>
      <%= ui_button "Run full report", type: "button", variant: :secondary, disabled: true %>
    <% else %>
      <%= button_to "Get my free Snapshot", show_reports_path(show, kind: "snapshot"), method: :post, class: "btn btn-primary btn-md" %>
      <%= button_to "Run full report", show_reports_path(show, kind: "agent"), method: :post, class: "btn btn-secondary btn-md" %>
    <% end %>
  </div>
  <% if paused %>
    <%# The notify list (WaitlistEntry with Billing::NOTIFY_KEY), joined with the account's email. %>
    <% if WaitlistEntry.exists?(email: current_user.email, price_key: Billing::NOTIFY_KEY) %>
      <p class="mt-3 text-sm text-ink-soft">You're on the list — we'll email you when they're back.</p>
    <% else %>
      <%= form_with url: waitlist_entries_path, class: "mt-3 flex flex-wrap items-center gap-3" do |f| %>
        <%= hidden_field_tag :price_key, Billing::NOTIFY_KEY %>
        <label class="flex items-center gap-2 text-sm">
          <%= check_box_tag :notify, "1", true, required: true %>
          Email me when new reports are back
        </label>
        <%= f.submit "Notify me", class: "btn btn-secondary btn-sm" %>
      <% end %>
    <% end %>
  <% end %>
  <% if active %>
    <p class="mt-3 text-sm"><%= link_to "Research in progress", show_report_path(show, active), class: "link" %></p>
  <% elsif (latest = show.latest_report) %>
    <p class="mt-3 text-sm"><%= link_to "See your latest report", show_report_path(show, latest), class: "link" %></p>
  <% end %>
<% end %>

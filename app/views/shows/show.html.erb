<% content_for :title, @show.title %>
<div class="flex flex-col gap-6">
  <header class="flex flex-wrap items-center gap-5">
    <%= render "shows/artwork", show: @show, size: "size-24" %>
    <div class="min-w-0 flex-1 basis-60">
      <h1 class="type-h1"><%= @show.title %></h1>
      <% if @show.author.present? %><p class="type-lead text-ink-soft"><%= @show.author %></p><% end %>
      <p class="mt-2 flex flex-wrap gap-2">
        <% @show.categories.each do |category| %><%= ui_badge category %><% end %>
      </p>
    </div>
    <div class="flex flex-col items-start gap-1">
      <%= ui_button "Media kit", edit_show_media_kit_path(@show), variant: :secondary %>
      <span class="text-sm text-ink-soft">
        <% if @show.public_kit? %>
          <%= link_to "Published", public_kit_path(@show.slug), class: "link" %>
        <% else %>
          <%= @show.verified? ? "Verified, not published" : "Not published" %>
        <% end %>
      </span>
    </div>
  </header>

  <%# The next action first: on a phone the run card would otherwise sit below the fold. %>
  <%= render "shows/report_actions", show: @show %>

  <%= render "components/card", title: "Details", aside: link_to("Edit", edit_show_path(@show), class: "link") do %>
    <dl class="grid gap-x-6 gap-y-3 sm:grid-cols-2">
      <div>
        <dt class="text-sm text-ink-soft">Downloads per episode</dt>
        <dd class="font-semibold"><%= @show.downloads_per_episode ? number_with_delimiter(@show.downloads_per_episode) : "Not set" %></dd>
      </div>
      <div>
        <dt class="text-sm text-ink-soft">Country</dt>
        <dd class="font-semibold"><%= Show::COUNTRIES.fetch(@show.country, @show.country) %></dd>
      </div>
      <div>
        <dt class="text-sm text-ink-soft">Comparable shows</dt>
        <dd class="font-semibold"><%= and_list(@show.hints[:comparable_shows]).presence || "None yet" %></dd>
      </div>
      <div>
        <dt class="text-sm text-ink-soft">Topics</dt>
        <dd class="font-semibold"><%= and_list(@show.hints[:topics]).presence || "None yet" %></dd>
      </div>
      <div>
        <dt class="text-sm text-ink-soft">Contact email</dt>
        <dd class="font-semibold"><%= @show.contact_email.presence || "Not set" %></dd>
      </div>
    </dl>
  <% end %>
</div>

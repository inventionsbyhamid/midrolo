<% content_for :title, "Your shows" %>
<div class="flex flex-col gap-6">
  <header class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="type-h1">Your shows</h1>
    <%= ui_button "Add another show", new_show_path, variant: :secondary %>
  </header>

  <%# Each card says whether the show is claimed (verified, its listing can go public), a draft workspace, or managed
      by another account, then ends on its next step: the latest report, or a first Snapshot. %>
  <% paused = AppSettings.runs_paused? %>
  <ul class="grid gap-4 sm:grid-cols-2">
    <% @shows.each do |show| %>
      <% report = show.latest_report %>
      <li class="card">
        <div class="card-body flex items-center gap-4">
          <%= render "shows/artwork", show: show %>
          <div class="min-w-0 flex-1">
            <%= link_to show.title, show_path(show), class: "type-h3 block truncate underline-offset-4 hover:underline" %>
            <p class="truncate text-ink-soft"><%= show.author %></p>
            <p class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
              <% case show.claim_status %>
              <% when :claimed %>
                <%= ui_badge "Claimed", tone: :success %>
                <%= link_to "Your listing", edit_show_media_kit_path(show), class: "link" %>
              <% when :managed_elsewhere %>
                <%= ui_badge "Managed by someone else", tone: :warning %>
                <%= link_to "Ask for access", new_podcast_claim_path(show.podcast), class: "link" %>
              <% else %>
                <%= ui_badge "Draft" %>
                <%= link_to "Verify you own it", new_show_verification_path(show), class: "link" %>
              <% end %>
            </p>
            <p class="mt-1 text-sm text-ink-soft">
              <% if report %>
                <%= link_to "Latest report: #{report.status_copy}", show_report_path(show, report), class: "link" %>
              <% else %>
                No report yet
              <% end %>
            </p>
            <% if report.nil? && !paused %>
              <%= button_to "Get my free Snapshot", show_reports_path(show, kind: "snapshot"), class: "btn btn-primary btn-sm mt-3" %>
            <% end %>
          </div>
        </div>
      </li>
    <% end %>
  </ul>
</div>

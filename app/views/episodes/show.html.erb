<% podcast, episode = @podcast, @episode %>
<% content_for :title, "#{episode.title} | #{podcast.title}" %>
<% description = [ ("Sponsored by #{Copy.and_list(@mentions.map { |mention| mention.brand.name }.uniq.first(3))}." if @mentions.any?),
                   episode.description.to_s.squish.presence || "An episode of #{podcast.title}." ].compact.join(" ") %>
<% card = ShareImages::PodcastCard.new(podcast, episode: episode) %>
<% content_for :meta, pages_meta(description: description.truncate(PodcastPagesHelper::DESCRIPTION_LIMIT, separator: " "),
                                  url: podcast_episode_url(podcast, episode),
                                  image: podcast_episode_share_image_url(podcast, episode, v: card.version), image_alt: card.alt) %>
<% content_for :head, pages_episode_json_ld(podcast, episode) %>
<%#
  An episode's page (plan 4.2): the notes from the show's feed, the sponsors found in them with codes and offers, the
  show's people, links to the episode on the show's own site and to its audio, and the episodes either side.
%>
<div class="wrap pb-12">
  <nav aria-label="Breadcrumb" class="pt-6">
    <ol class="crumbs">
      <li><%= link_to "Podcasts", podcasts_path %></li>
      <li><%= link_to podcast.title, podcast_path(podcast) %></li>
      <li aria-current="page">Episode</li>
    </ol>
  </nav>

  <header class="ep-hero">
    <%= link_to podcast_path(podcast), class: "ep-show" do %>
      <%= podcast_artwork_tag(podcast, size: :thumb, class: "size-12 rounded-lg") %>
      <span><%= podcast.title %></span>
    <% end %>
    <h1 class="ep-h1"><%= episode.title %></h1>
    <% meta = [ (tag.time(pages_date(episode.published_at), datetime: episode.published_at.iso8601) if episode.published_at),
                pages_episode_number(episode), pages_duration(episode.duration_seconds) ].compact %>
    <% if meta.any? %>
      <p class="ep-meta text-sm"><%= safe_join(meta, tag.span(" · ", aria: { hidden: true })) %></p>
    <% end %>
    <% listen = [ ([ "Listen on the show's site", Show.http_url(episode.link) ] if Show.http_url(episode.link)),
                  ([ "Audio file", Show.http_url(episode.enclosure_url) ] if Show.http_url(episode.enclosure_url)) ].compact %>
    <% if listen.any? %>
      <p class="flex flex-wrap gap-2 pt-1">
        <% listen.each_with_index do |(label, href), index| %>
          <%= link_to label, href, class: class_names("btn btn-md", index.zero? ? "btn-primary" : "btn-secondary"), rel: "nofollow noopener", target: "_blank" %>
        <% end %>
      </p>
    <% end %>
  </header>

  <div class="pod-layout">
    <div class="pod-main">
      <section class="pod-section" aria-labelledby="sponsors_title">
        <h2 id="sponsors_title" class="pod-h2">Sponsors in this episode</h2>
        <% if @mentions.any? %>
          <p class="pod-note">Found in the episode's show notes.</p>
          <ul class="mention-list">
            <% @mentions.each do |mention| %>
              <li class="mention">
                <p class="flex flex-wrap items-center gap-2">
                  <%= link_to mention.brand.name, public_brand_path(mention.brand.slug), class: "mention-brand link text-ink" %>
                  <% if mention.promo_code.present? %><%= ui_badge "Code #{mention.promo_code}", tone: :accent %><% end %>
                </p>
                <% if mention.offer.present? %><p class="mt-1"><%= mention.offer %></p><% end %>
                <% if mention.evidence.present? %><blockquote class="mention-evidence">"<%= mention.evidence %>"</blockquote><% end %>
                <% if (href = Show.http_url(mention.url)) %>
                  <p class="mt-2 text-sm"><%= link_to pages_host(href) || href, href, class: "link", rel: "nofollow noopener sponsored", target: "_blank" %></p>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <div class="pod-empty">
            <p class="pod-empty-title">No sponsor reads found in this episode's notes.</p>
            <p class="text-ink-soft">Host-read ads that the notes don't mention can't be found this way.</p>
          </div>
        <% end %>
      </section>

      <section class="pod-section" aria-labelledby="notes_title">
        <h2 id="notes_title" class="pod-h2">Show notes</h2>
        <% if episode.description.present? %>
          <div class="pod-prose"><%= pages_prose(episode.description) %></div>
          <p class="pod-note">From the show's RSS feed.</p>
        <% else %>
          <p class="pod-note">The feed has no notes for this episode.</p>
        <% end %>
      </section>

      <% hosts = @podcast.people.select(&:host?).first(6) %>
      <% if hosts.any? %>
        <section class="pod-section" aria-labelledby="hosts_title">
          <h2 id="hosts_title" class="pod-h2">Hosts</h2>
          <ul class="people">
            <% hosts.each do |person| %>
              <li class="person">
                <span class="person-photo" aria-hidden="true"><%= Podcast.initials_for(person.name) %></span>
                <p class="person-name"><%= person.name %></p>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>

      <% if @newer || @older %>
        <nav class="pod-section" aria-label="More episodes">
          <div class="ep-nav">
            <% if @older %>
              <%= link_to podcast_episode_path(podcast, @older), class: "ep-nav-link", rel: "prev" do %>
                <span class="ep-nav-label">Older episode</span><span class="font-semibold"><%= @older.title %></span>
              <% end %>
            <% else %><span></span><% end %>
            <% if @newer %>
              <%= link_to podcast_episode_path(podcast, @newer), class: "ep-nav-link ep-nav-next", rel: "next" do %>
                <span class="ep-nav-label">Newer episode</span><span class="font-semibold"><%= @newer.title %></span>
              <% end %>
            <% end %>
          </div>
        </nav>
      <% end %>
    </div>

    <aside class="pod-side" aria-label="The show">
      <%= render "components/card", title: "The show", heading: :h2 do %>
        <div class="flex items-center gap-3">
          <%= podcast_artwork_tag(podcast, size: :thumb, class: "size-16") %>
          <div class="min-w-0">
            <p class="font-bold leading-tight"><%= podcast.title %></p>
            <% if podcast.author.present? %><p class="text-sm text-ink-soft">By <%= podcast.author %></p><% end %>
          </div>
        </div>
        <ul class="mt-3 flex flex-wrap gap-1.5">
          <% if podcast.open_to_sponsors? %><li><%= ui_badge "Open to sponsors", tone: :success %></li><% end %>
          <% if podcast.min_price_cents %><li class="chip">From <%= pages_money(podcast.min_price_cents) %></li><% end %>
          <% if pages_cadence(podcast) %><li class="chip"><%= pages_cadence(podcast) %></li><% end %>
        </ul>
        <%= ui_button "See the show's page", podcast_path(podcast), variant: :secondary, size: :sm, class: "mt-4 w-full" %>
      <% end %>
      <div class="fine-print">
        <p><%= APP_NAME %> isn't affiliated with <%= podcast.title %>. This page is built from the show's public RSS feed.</p>
        <p><%= link_to "Remove this page", new_podcast_removal_path(podcast), class: "link text-ink-soft", rel: "nofollow" %></p>
      </div>
    </aside>
  </div>
</div>

<%# locals: (show:, reading:, owner:, locked: false, verified: false) -%>
<%# The fallback (build spec section 11): the owner's own downloads per episode, labelled "Provided by the show". %>
<%# Once Spotify or Apple numbers are verified this is a fallback, so it folds to one line (review ST-5). %>
<% if verified && reading.nil? %>
  <details class="card px-6 py-4">
    <summary class="cursor-pointer"><span class="link font-semibold">Add your own downloads per episode</span> <span class="text-sm text-ink-soft">Used only when there's no verified number</span></summary>
    <div class="mt-4 flex flex-col gap-4">
      <%= render "stats/provided_form", show: show, reading: reading, owner: owner, locked: locked %>
    </div>
  </details>
<% else %>
<%= render "components/card", title: "Numbers provided by the show", aside: (trust_badge(reading) if reading) do %>
  <div class="flex flex-col gap-4">
    <%= render "stats/provided_form", show: show, reading: reading, owner: owner, locked: locked %>
  </div>
<% end %>
<% end %>

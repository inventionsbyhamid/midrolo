<% content_for :title, "Move a show to another owner" %>
<div class="mx-auto flex max-w-2xl flex-col gap-6">
  <header>
    <p class="text-sm font-semibold"><%= link_to "Admin", admin_root_path, class: "link" %></p>
    <h1 class="type-h2">Move a show to another owner</h1>
  </header>
  <%= render "components/card" do %>
    <p class="text-ink-soft">For a show managed by someone else whose real owner wrote in. Check their proof first: an email from the feed's owner address, or a host dashboard screenshot. The current owner's workspace becomes a draft and keeps its reports.</p>
    <%= form_with url: admin_claim_transfers_path, class: "mt-5 flex flex-col gap-4" do |f| %>
      <div>
        <%= f.label :podcast, "Podcast page or slug", class: "label" %>
        <%= f.text_field :podcast, value: params[:podcast], class: "input", required: true, placeholder: "https://midrolo.com/podcasts/the-founders-ledger-ab12cd" %>
      </div>
      <div>
        <%= f.label :email, "New owner's account email", class: "label" %>
        <%= f.email_field :email, value: params[:email], class: "input", required: true %>
      </div>
      <%= f.submit "Move the show", class: "btn btn-primary btn-md self-start", data: { turbo_confirm: "Move this show to that account?" } %>
    <% end %>
  <% end %>
</div>

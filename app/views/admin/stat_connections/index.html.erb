<% content_for :title, "Stats connections" %>
<% titles = { "pending_invite" => "Pending invites, oldest first", "mismatch" => "Doesn't match", "failed" => "Failed",
              "disconnected" => "Disconnected", "active" => "Active" } %>
<div class="flex flex-col gap-6">
  <header class="flex flex-wrap items-baseline justify-between gap-3">
    <h1 class="type-h1">Stats connections</h1>
    <nav class="flex gap-4" aria-label="Stats admin">
      <%= link_to "Service sessions", admin_service_sessions_path, class: "link" %>
      <%= link_to "Back to admin", admin_root_path, class: "link" %>
    </nav>
  </header>

  <p class="max-w-prose text-ink-soft">
    Accept each pending invite in the stats account's inbox (<%= Copy.and_list(Stats::PLATFORMS.keys.map { |p| Stats.invite_email(p) }.uniq) %>).
    Midrolo checks pending invites every 15 minutes, so a connection turns active by itself once the invite is accepted.
  </p>

  <% paused = Stats::PLATFORMS.keys.reject { |p| @sessions[p]&.ok? && @sessions[p].credentials.present? } %>
  <% if paused.any? %>
    <p class="flash flash-alert" role="status">
      Syncs are paused for <%= Copy.and_list(paused.map { |p| Stats.platform_name(p) }) %>: no working session.
      <%= link_to "Update the sessions", admin_service_sessions_path, class: "link" %>
    </p>
  <% end %>

  <% @groups.each do |status, connections| %>
    <%= render "components/card", title: titles.fetch(status), aside: ui_badge(number_with_delimiter(@counts.fetch(status, 0))) do %>
      <% if connections.empty? %>
        <p class="text-ink-soft">None.</p>
      <% else %>
        <div class="relative overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead>
              <tr>
                <th scope="col" class="py-2 pr-4 font-semibold">Podcast</th>
                <th scope="col" class="py-2 pr-4 font-semibold">Platform</th>
                <th scope="col" class="py-2 pr-4 font-semibold">Connected by</th>
                <th scope="col" class="py-2 pr-4 font-semibold"><%= status == "pending_invite" ? "Waiting" : "Last checked" %></th>
                <th scope="col" class="py-2 pr-4 font-semibold">Note</th>
                <th scope="col" class="py-2 font-semibold"><span class="sr-only">Actions</span></th>
              </tr>
            </thead>
            <tbody>
              <% connections.each do |connection| %>
                <tr class="border-t border-line align-top">
                  <td class="py-3 pr-4">
                    <%= connection.podcast.title %>
                    <% if connection.podcast.claimed? %> <%= ui_badge "Claimed", tone: :success %><% end %>
                  </td>
                  <td class="py-3 pr-4">
                    <%= link_to Stats.platform_name(connection.provider), Stats.show_url(connection.provider, connection.external_id),
                          class: "link", target: "_blank", rel: "noopener noreferrer" %>
                    <span class="block max-w-40 truncate text-xs text-ink-soft" title="<%= connection.external_id %>"><%= connection.external_id %></span>
                  </td>
                  <td class="py-3 pr-4"><%= connection.user&.email || "Account deleted" %></td>
                  <td class="py-3 pr-4 whitespace-nowrap">
                    <% if status == "pending_invite" %>
                      <%= time_ago_in_words(connection.created_at) %>
                    <% else %>
                      <%= connection.last_checked_at ? "#{time_ago_in_words(connection.last_checked_at)} ago" : "Never" %>
                    <% end %>
                  </td>
                  <td class="py-3 pr-4 text-ink-soft"><%= connection.last_error.presence || "" %></td>
                  <td class="py-3">
                    <div class="flex flex-wrap gap-2">
                      <% if Stats::Ownership.needs_review?(connection) %>
                        <%= button_to "Approve", approve_admin_stat_connection_path(connection), class: "btn btn-primary btn-sm",
                              form: { data: { turbo_confirm: "Approve after checking that #{Stats.platform_name(connection.provider)} #{connection.external_id} is #{connection.podcast.title}?" } } %>
                        <%= button_to "Reject", reject_admin_stat_connection_path(connection), class: "btn btn-secondary btn-sm",
                              form: { data: { turbo_confirm: "Reject after checking that #{Stats.platform_name(connection.provider)} #{connection.external_id} isn't #{connection.podcast.title}? The connection is disconnected and its #{Stats.platform_name(connection.provider)} numbers come off the page." } } %>
                      <% end %>
                      <%= button_to "Check now", check_admin_stat_connection_path(connection), class: "btn btn-secondary btn-sm" %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>

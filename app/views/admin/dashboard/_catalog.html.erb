<%# Lane L1: the catalog's counts and its latest feed errors (locals: stats, the dashboard's Admin::Stats, unused here). %>
<% catalog = Catalog::Summary.call %>
<%= render "components/card", title: "Catalog" do %>
  <dl class="grid grid-cols-2 gap-x-6 gap-y-2 text-sm tabular-nums sm:grid-cols-4">
    <% [ [ "Podcasts", catalog.total ], [ "Indexable", catalog.indexable ], [ "Claimed", catalog.claimed ],
         [ "Linked to Qloo", catalog.qloo_linked ], [ "Episodes", catalog.episodes ], [ "Due for a read", catalog.due ],
         [ "Never read", catalog.never_read ] ].each do |label, count| %>
      <div class="flex flex-col">
        <dt class="text-ink-soft"><%= label %></dt>
        <dd class="font-semibold"><%= number_with_delimiter(count) %></dd>
      </div>
    <% end %>
  </dl>

  <ul class="mt-4 flex flex-wrap gap-2" aria-label="Podcasts by status">
    <% catalog.by_status.each do |status, count| %>
      <li class="flex items-center gap-1 text-sm"><%= catalog_status_badge(status) %> <span class="tabular-nums"><%= number_with_delimiter(count) %></span></li>
    <% end %>
  </ul>

  <h3 class="mt-6 font-semibold">Latest feed errors</h3>
  <% if catalog.errors.empty? %>
    <p class="mt-2 text-ink-soft">No feed errors.</p>
  <% else %>
    <div class="mt-2 overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead>
          <tr>
            <th scope="col" class="py-2 pr-4 font-semibold">Checked (UTC)</th>
            <th scope="col" class="py-2 pr-4 font-semibold">Podcast</th>
            <th scope="col" class="py-2 pr-4 font-semibold">Status</th>
            <th scope="col" class="py-2 pr-4 font-semibold">Error</th>
            <th scope="col" class="py-2 pr-4 text-right font-semibold">In a row</th>
            <th scope="col" class="py-2 font-semibold">Next read (UTC)</th>
          </tr>
        </thead>
        <tbody>
          <% catalog.errors.each do |podcast| %>
            <tr class="border-t border-line align-top">
              <td class="py-2 pr-4 whitespace-nowrap tabular-nums"><%= podcast.feed_checked_at&.utc&.strftime("%b %-d %H:%M") || "Never" %></td>
              <td class="py-2 pr-4"><%= podcast.title %></td>
              <td class="py-2 pr-4"><%= catalog_status_badge(podcast.status) %></td>
              <td class="py-2 pr-4"><%= catalog_error_label(podcast.last_error) %></td>
              <td class="py-2 pr-4 text-right tabular-nums"><%= podcast.fetch_failures %></td>
              <td class="py-2 whitespace-nowrap tabular-nums"><%= podcast.next_fetch_at&.utc&.strftime("%b %-d %H:%M") || "Not scheduled" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
  <p class="mt-3 text-sm text-ink-soft">
    Feeds are read every hour for claimed shows, then less often the older the last episode (6 hours to 7 days).
    Each failure in a row doubles the wait, up to 7 days. Seed with <code>bin/rails catalog:seed[1000]</code> in the worker.
  </p>
<% end %>

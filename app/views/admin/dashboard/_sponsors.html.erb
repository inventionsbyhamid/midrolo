<%# locals: (stats:) -%>
<%# Lane L2's admin dashboard panel: sponsor detection (Sponsors::Overview), and the catalog LLM budget it spends. Renders only on the dashboard, which passes its Admin::Stats. %>
<% if stats %>
  <% overview = Sponsors::Overview.new %>
  <%= render "components/card", title: "Sponsor detection" do %>
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
      <%= render "components/stat", value: number_with_delimiter(overview.mentions), label: "Sponsor reads",
                 note: "#{number_with_delimiter(overview.by_detector.fetch('llm', 0))} checked by the model" %>
      <%= render "components/stat", value: number_with_delimiter(overview.brands), label: "Brands" %>
      <%= render "components/stat", value: number_with_delimiter(overview.podcasts), label: "Shows with sponsors" %>
      <%= render "components/stat", value: number_with_delimiter(overview.waiting), label: "Episodes waiting for a scan",
                 note: "#{number_with_delimiter(overview.found_today)} reads found today" %>
    </div>
    <div class="mt-4">
      <%= admin_budget_meter("Today, catalog", stats.budgets[:catalog]) %>
    </div>
    <p class="mt-3 text-sm text-ink-soft">
      Patterns find explicit reads for free. The model checks episodes with any hint, ten at a time, until the catalog
      budget is spent; their episodes wait and <code>bin/rails sponsors:scan</code> picks them up later.
    </p>
    <% if overview.latest.any? %>
      <div class="relative mt-4 overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr>
              <th scope="col" class="py-2 pr-4 font-semibold">Found (UTC)</th>
              <th scope="col" class="py-2 pr-4 font-semibold">Brand</th>
              <th scope="col" class="py-2 pr-4 font-semibold">Show</th>
              <th scope="col" class="py-2 pr-4 font-semibold">By</th>
              <th scope="col" class="py-2 font-semibold">Evidence</th>
            </tr>
          </thead>
          <tbody>
            <% overview.latest.each do |mention| %>
              <tr class="border-t border-line align-top">
                <td class="py-2 pr-4 whitespace-nowrap tabular-nums"><%= mention.created_at.utc.strftime("%b %-d %H:%M") %></td>
                <td class="py-2 pr-4"><%= mention.brand.name %></td>
                <td class="py-2 pr-4"><%= mention.podcast.title %></td>
                <td class="py-2 pr-4 whitespace-nowrap"><%= mention.detected_by == "llm" ? "Model" : "Pattern" %> <%= number_to_percentage((mention.confidence || 0) * 100, precision: 0) %></td>
                <td class="py-2"><%= mention.evidence.to_s.truncate(120) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  <% end %>
<% end %>

<% content_for :title, "Admin" %>
<% budgets = @stats.budgets %>
<div class="flex flex-col gap-6">
  <header class="flex flex-wrap items-baseline justify-between gap-3">
    <h1 class="type-h1">Admin</h1>
    <%= link_to "Jobs", mission_control_jobs_path, class: "link", data: { turbo: false } %>
  </header>

  <%= render "components/card", title: "New runs" do %>
    <% if AppSettings.runs_paused? %>
      <p class="flex flex-wrap items-center gap-2">
        <%= ui_badge "Paused", tone: :danger %>
        <span><%= AppSettings.get(:runs_paused_reason).presence || "No reason given" %></span>
      </p>
      <p class="mt-2 text-sm text-ink-soft">New reports, Snapshots and pitches are refused. Running work finishes.</p>
      <%= button_to "Resume new runs", admin_pause_path, method: :delete, class: "btn btn-primary btn-md mt-4" %>
    <% else %>
      <p><%= ui_badge "Running", tone: :success %></p>
      <%= form_with url: admin_pause_path, class: "mt-4 flex flex-wrap items-end gap-3" do |f| %>
        <div class="flex min-w-0 flex-1 basis-64 flex-col gap-1">
          <%= f.label :reason, "Reason (users see it)", class: "label" %>
          <%= f.text_field :reason, class: "input", required: true, maxlength: Admin::PausesController::REASON_MAX %>
        </div>
        <%= f.submit "Pause new runs", class: "btn btn-danger btn-md" %>
      <% end %>
    <% end %>
  <% end %>

  <%= render "components/card", title: "Budgets" do %>
    <div class="flex flex-col gap-3">
      <%= admin_budget_meter("Promo", budgets[:promo]) %>
      <%= admin_budget_meter("Judge", budgets[:judge]) %>
      <%= admin_budget_meter("Today, all buckets", budgets[:daily]) %>
    </div>
    <p class="mt-3 text-sm text-ink-soft">
      Promo and judge count all their spend, not just today's. The judge ceiling is its reserve plus unspent promo. The daily cap stops promo
      and paid work.
    </p>
  <% end %>

  <%= render "components/card", title: "Qloo calls" do %>
    <% calls = @stats.qloo_calls %>
    <div class="flex flex-col gap-3">
      <%= admin_call_meter("Qloo calls today", calls.today, calls.daily_limit) %>
      <%= admin_call_meter("This minute", calls.minute, calls.per_minute) %>
      <%= admin_call_meter("Free Snapshots today", calls.free_today, calls.free_limit) %>
    </div>
    <p class="mt-3 text-sm text-ink-soft">
      Every live call to Qloo counts, retries included. Cached answers are free. Over a cap, new calls are refused until the
      next minute or the next UTC day; optional steps skip and reports that need the data fail without charge. Free plan
      Snapshots may use their share of the day; judges, promo and paid runs use the rest.
    </p>
  <% end %>

  <%= render "components/card", title: "Go live check" do %>
    <% margins = @stats.margins %>
    <% inputs = margins.inputs %>
    <% if @stats.live_blockers.any? %>
      <div class="flash flash-alert mb-4" role="alert">
        <p>BILLING_MODE is live, but paid plans show the waitlist until this passes:</p>
        <ul class="mt-1 list-disc pl-5"><% @stats.live_blockers.each do |blocker| %><li><%= blocker.upcase_first %></li><% end %></ul>
      </div>
    <% end %>
    <p class="mb-3 text-sm text-ink-soft">
      Live billing needs the Qloo cost per call set and every paid plan keeping
      <%= admin_percent(Billing::Margins::MIN_MARGIN) %> or more at its caps.
      <%= margins.ready? ? "Both hold now." : "Not yet: #{margins.blockers.join('; ')}." %>
    </p>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm tabular-nums">
        <thead>
          <tr>
            <th scope="col" class="py-2 pr-4 font-semibold">Plan</th>
            <th scope="col" class="py-2 pl-4 text-right font-semibold">Price</th>
            <th scope="col" class="py-2 pl-4 text-right font-semibold">Net after fees</th>
            <th scope="col" class="py-2 pl-4 text-right font-semibold">LLM at caps</th>
            <th scope="col" class="py-2 pl-4 text-right font-semibold">Qloo calls at caps</th>
            <th scope="col" class="py-2 pl-4 text-right font-semibold">Qloo at caps</th>
            <th scope="col" class="py-2 pl-4 text-right font-semibold">Margin at caps</th>
          </tr>
        </thead>
        <tbody>
          <% margins.rows.each do |row| %>
            <tr class="border-t border-line">
              <th scope="row" class="py-2 pr-4 font-normal"><%= row.label %></th>
              <td class="py-2 pl-4 text-right"><%= admin_usd(row.price.usd) %></td>
              <td class="py-2 pl-4 text-right"><%= admin_usd(row.net_usd) %></td>
              <td class="py-2 pl-4 text-right"><%= admin_usd(row.llm_usd) %></td>
              <td class="py-2 pl-4 text-right"><%= number_with_delimiter(row.qloo_calls) %></td>
              <td class="py-2 pl-4 text-right"><%= row.qloo_usd ? admin_usd(row.qloo_usd) : "Not set" %></td>
              <td class="py-2 pl-4 text-right"><%= admin_percent(row.margin) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-sm text-ink-soft">
      At caps: every full report, Snapshot and pitch the plan allows (a yearly plan, 12 months of them), on worst case Dodo
      fees of 6% plus $0.40 a payment. LLM: <%= admin_usd(inputs.agent_llm_usd) %> a full report and
      <%= admin_usd(inputs.pitch_llm_usd) %> a pitch, or the measured average when higher. The pitch figure is an estimate
      from the design notes, since the app kept none. Qloo: <%= inputs.agent_calls %> calls a full report and
      <%= inputs.snapshot_calls %> a Snapshot (the research cap, or the measured average when higher), at
      <%= inputs.cost_per_call ? "#{number_to_currency(inputs.cost_per_call, precision: 4)} a call" : "a price per call not set yet" %>.
    </p>
  <% end %>

  <%= render "components/card", title: "Totals" do %>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm tabular-nums">
        <thead>
          <tr>
            <th scope="col" class="py-2 pr-4"><span class="sr-only">Metric</span></th>
            <% AdminHelper::ADMIN_PERIODS.each_value do |label| %>
              <th scope="col" class="py-2 pl-4 text-right font-semibold"><%= label %></th>
            <% end %>
          </tr>
        </thead>
        <% admin_total_groups(@stats).each do |group, rows| %>
          <tbody>
            <% if group %>
              <tr class="border-t border-line"><th scope="rowgroup" colspan="3" class="pt-4 pb-2 font-semibold"><%= group %></th></tr>
            <% end %>
            <% if rows.empty? %>
              <tr class="border-t border-line"><td colspan="3" class="py-2 text-ink-soft">None this month.</td></tr>
            <% end %>
            <% rows.each do |label, values| %>
              <tr class="border-t border-line">
                <th scope="row" class="py-2 pr-4 font-normal"><%= label %></th>
                <% AdminHelper::ADMIN_PERIODS.each_key do |period| %>
                  <td class="py-2 pl-4 text-right"><%= values.fetch(period) %></td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        <% end %>
      </table>
    </div>
  <% end %>

  <%= render "components/card", title: "Settings" do %>
    <% if @settings.errors.any? %>
      <div class="flash flash-alert mb-4" role="alert">
        <ul><% @settings.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
      </div>
    <% end %>
    <%= form_with model: @settings, scope: :settings, url: admin_settings_path, method: :patch, class: "flex flex-col gap-4" do |f| %>
      <div class="grid gap-4 sm:grid-cols-2">
        <% Admin::SettingsForm::BUDGET_KEYS.each do |key| %>
          <div class="flex flex-col gap-1">
            <%= f.label key, "#{Admin::SettingsForm.human_attribute_name(key)} (USD)", class: "label" %>
            <%= f.number_field key, class: "input", min: 0, step: "0.01", required: true,
                  aria: { invalid: @settings.errors.include?(key) } %>
          </div>
        <% end %>
        <div class="flex flex-col gap-1">
          <%= f.label :promo_pro_until, Admin::SettingsForm.human_attribute_name(:promo_pro_until), class: "label" %>
          <%= f.date_field :promo_pro_until, class: "input", required: true,
                aria: { invalid: @settings.errors.include?(:promo_pro_until) } %>
        </div>
        <div class="flex flex-col gap-1">
          <%= f.label :qloo_daily_call_limit, Admin::SettingsForm.human_attribute_name(:qloo_daily_call_limit), class: "label" %>
          <%= f.number_field :qloo_daily_call_limit, class: "input", min: 0, step: 1, required: true,
                aria: { invalid: @settings.errors.include?(:qloo_daily_call_limit) } %>
        </div>
        <div class="flex flex-col gap-1">
          <%= f.label :qloo_free_share, "#{Admin::SettingsForm.human_attribute_name(:qloo_free_share)} (0 to 1)", class: "label" %>
          <%= f.number_field :qloo_free_share, class: "input", min: 0, max: 1, step: "any", required: true,
                aria: { invalid: @settings.errors.include?(:qloo_free_share) } %>
        </div>
        <div class="flex flex-col gap-1">
          <%= f.label :qloo_cost_per_call_usd, "#{Admin::SettingsForm.human_attribute_name(:qloo_cost_per_call_usd)} (USD, blank until Qloo quotes)",
                class: "label" %>
          <%= f.number_field :qloo_cost_per_call_usd, class: "input", min: 0, step: "any",
                aria: { invalid: @settings.errors.include?(:qloo_cost_per_call_usd) } %>
        </div>
      </div>
      <%= f.submit "Save settings", class: "btn btn-primary btn-md self-start" %>
    <% end %>
  <% end %>

  <%= render "components/card", title: "Latest failed reports" do %>
    <% failed = @stats.failed_reports %>
    <% if failed.empty? %>
      <p class="text-ink-soft">No failed reports.</p>
    <% else %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr>
              <th scope="col" class="py-2 pr-4 font-semibold">Failed (UTC)</th>
              <th scope="col" class="py-2 pr-4 font-semibold">Show</th>
              <th scope="col" class="py-2 pr-4 font-semibold">Kind</th>
              <th scope="col" class="py-2 font-semibold">Error</th>
            </tr>
          </thead>
          <tbody>
            <% failed.each do |report| %>
              <tr class="border-t border-line align-top">
                <td class="py-2 pr-4 whitespace-nowrap tabular-nums"><%= (report.finished_at || report.updated_at).utc.strftime("%b %-d %H:%M") %></td>
                <td class="py-2 pr-4"><%= report.show.title %></td>
                <td class="py-2 pr-4"><%= report.kind.humanize %></td>
                <td class="py-2"><%= report.error_message.presence || "None" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  <% end %>
</div>

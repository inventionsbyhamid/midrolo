<%# locals: (podcast:, title:) -%>
<header class="flex items-center gap-4">
  <%= podcast_artwork_tag(podcast, class: "size-16") %>
  <div class="min-w-0">
    <p class="flex flex-wrap items-center gap-2 text-sm font-semibold">
      <%= link_to podcast.title, listing_podcast_path(podcast), class: "link truncate" %>
      <%= listing_demo_badge(podcast) %>
    </p>
    <h1 class="type-h2"><%= title %></h1>
  </div>
</header>

<%# locals: (prompt:) -%>
<%# Why the plan said no and what next (R63), from the refusal's details as captured then (NotAllowed#details). %>
<% copy = upgrade_prompt_copy(prompt) %>
<div class="upgrade-prompt" role="status" data-upgrade-reason="<%= prompt.fetch(:reason) %>">
  <p class="font-semibold"><%= copy.message %></p>
  <% if copy.detail %><p class="text-[0.9375rem] text-ink-soft"><%= copy.detail %></p><% end %>
  <% if copy.action %><%= link_to copy.action, pricing_path, class: "btn btn-primary btn-md self-start" %><% end %>
</div>

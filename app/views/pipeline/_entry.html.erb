<%# locals: (sponsor_match:) -%>
<%# One brand on the pipeline page. An open deal's follow-up due today or overdue is flagged (data-follow-up). %>
<% match = sponsor_match %>
<% name_id = dom_id(match, :pipeline_name) %>
<article class="card pipeline-entry" data-pipeline-entry <%= tag.attributes(data: { follow_up: match.follow_up_alert }) %> aria-labelledby="<%= name_id %>">
  <div class="flex items-start gap-3">
    <%= render "sponsor_matches/logo", sponsor_match: match, size: "size-11 text-sm" %>
    <div class="min-w-0 flex-1">
      <h3 id="<%= name_id %>" class="match-name"><%= match.name %></h3>
      <%# A no-break space keeps the dot with the show's title when the line wraps. %>
      <p class="text-sm text-ink-soft"><%= [ match.show.title, category_label(match.category) ].compact.join("\u00A0· ") %></p>
    </div>
    <%= tier_badge(match.tier) %>
  </div>

  <% if match.fit_score %>
    <div class="mt-3"><%= ui_meter match.fit_score / 100.0, label: "Fit", value_text: match.fit_score.to_s %></div>
  <% end %>

  <% if match.notes.present? %>
    <p class="pipeline-note" data-pipeline-note><%= truncate(match.notes.squish, length: 160, separator: " ") %></p>
  <% end %>

  <div class="pipeline-entry-footer">
    <% if match.follow_up_on %>
      <p class="pipeline-follow-up">
        <svg viewBox="0 0 16 16" class="size-4 flex-none" aria-hidden="true"><path d="M3 4.5h10v8.5H3zM3 7h10M5.5 3v2.5M10.5 3v2.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>Follow up <%= follow_up_time(match.follow_up_on) %></span>
        <%= follow_up_badge(match) %>
      </p>
    <% end %>
    <%= link_to show_report_path(match.show_id, match.report_id, anchor: dom_id(match)), class: "link pipeline-open" do %>Open in report<span class="sr-only">: <%= match.name %></span><% end %>
  </div>
</article>

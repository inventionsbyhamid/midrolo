<!DOCTYPE html>
<html lang="en">
  <head>
    <%= render "layouts/head" %>
  </head>

  <%# Public pages. Main is full-bleed: each section sets its own width with .wrap. %>
  <body class="flex min-h-dvh flex-col">
    <a href="#main" class="skip-link">Skip to content</a>
    <%= render "components/demo_banner" if demo_mode? %>
    <%= render "components/nav",
          links: [ [ "How it works", "/#how-it-works" ], [ "Samples", "/#samples" ], [ "Pricing", "/pricing" ] ],
          cta: user_signed_in? ? [ "Open #{APP_NAME}", "/shows" ] : [ "Sign in", new_user_session_path ] %>
    <%= render "components/flash" %>
    <main id="main" tabindex="-1" class="flex-1">
      <%= yield %>
    </main>
    <%= render "components/footer" %>
  </body>
</html>

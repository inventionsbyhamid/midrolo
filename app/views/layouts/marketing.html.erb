<!DOCTYPE html>
<html lang="en">
  <head>
    <%= render "layouts/head" %>
  </head>

  <%# Public pages. Main is full-bleed: each section sets its own width with .wrap. Visitors get the public links
      (NavigationHelper: Podcasts, For brands, the blog once a post is published (R148), Pricing) and Sign in; a
      signed-in person gets their own links and Sign out. %>
  <body class="flex min-h-dvh flex-col">
    <a href="#main" class="skip-link">Skip to content</a>
    <%= render "shared/masquerade_banner" %>
    <%= render "components/demo_banner" if demo_mode? %>
    <%= render "components/nav", links: nav_site_links,
          cta: ([ "Sign in", new_user_session_path ] unless user_signed_in?), sign_out: user_signed_in? %>
    <%= render "components/flash" %>
    <main id="main" tabindex="-1" class="flex-1">
      <%= yield %>
    </main>
    <%= render "components/footer" %>
  </body>
</html>

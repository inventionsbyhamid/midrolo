<!DOCTYPE html>
<html lang="en">
  <head>
    <%= render "layouts/head" %>
  </head>

  <%# Public pages. Main is full-bleed: each section sets its own width with .wrap. The blog joins the nav once a post
      is published (R148). %>
  <body class="flex min-h-dvh flex-col">
    <a href="#main" class="skip-link">Skip to content</a>
    <%= render "shared/masquerade_banner" %>
    <%= render "components/demo_banner" if demo_mode? %>
    <%= render "components/nav",
          links: [ [ "How it works", "/#how-it-works" ], [ "Samples", samples_path ], [ "Pricing", pricing_path ],
                   ([ "Blog", blog_path ] if blog_listed?) ].compact,
          cta: user_signed_in? ? [ "Go to my shows", shows_path ] : [ "Sign in", new_user_session_path ] %>
    <%= render "components/flash" %>
    <main id="main" tabindex="-1" class="flex-1">
      <%= yield %>
    </main>
    <%= render "components/footer" %>
  </body>
</html>

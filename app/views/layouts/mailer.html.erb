<!DOCTYPE html>
<html lang="en">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= message.subject %></title>
  </head>
  <%# Email clients ignore stylesheets, so every style is inline. Colors are the app's ink, plum and tally tokens. %>
  <body style="margin:0;padding:0;background:#f6f2f4;color:#22132b;font-family:Archivo,-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f6f2f4;">
      <tr>
        <td align="center" style="padding:32px 16px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:520px;">
            <tr>
              <td style="padding:0 4px 16px;font-size:20px;font-weight:800;letter-spacing:-0.5px;">
                <span style="display:inline-block;width:10px;height:10px;border-radius:5px;background:#f3a712;margin-right:8px;vertical-align:middle;"></span><%= APP_NAME %>
              </td>
            </tr>
            <tr>
              <td style="background:#ffffff;border:1px solid #e3dae3;border-radius:18px;padding:28px 28px 24px;font-size:16px;line-height:1.6;">
                <%= yield %>
              </td>
            </tr>
            <tr>
              <td style="padding:16px 4px;font-size:13px;line-height:1.5;color:#5a4a63;">
                <%= APP_NAME %> · sponsor research for independent podcasts · midrolo.com
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>

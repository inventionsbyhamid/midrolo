<!DOCTYPE html>
<html lang="en">
  <head>
    <%= render "layouts/head" %>
  </head>

  <%# The fallback layout (sign-in, one-off pages): logo, flash, a centered column. %>
  <body class="flex min-h-dvh flex-col">
    <a href="#main" class="skip-link">Skip to content</a>
    <%= render "components/demo_banner" if demo_mode? %>
    <header class="wrap flex h-16 items-center">
      <%= link_to brand_logo, "/", class: "logo", aria: { label: "#{APP_NAME} home" } %>
    </header>
    <%= render "components/flash" %>
    <main id="main" tabindex="-1" class="wrap flex-1 py-10">
      <%= yield %>
    </main>
    <%= render "components/footer" %>
  </body>
</html>

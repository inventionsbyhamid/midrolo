<%# locals: (sponsor_match:) -%>
<%# A match beyond the plan's visible limit (R43): nothing about the brand reaches the HTML (no name, image,
    website, reason or evidence), only its tier and a coarse fit bucket. %>
<li class="match-row match-locked" data-locked-match>
  <div class="match-logo"><span class="avatar size-11 text-sm">••</span></div>
  <div class="match-head">
    <span class="locked-line w-2/5"></span>
  </div>
  <div class="match-fit">
    <%= tier_badge(sponsor_match.tier) %>
    <p class="text-sm font-semibold"><%= fit_bucket(sponsor_match.fit_score) %></p>
  </div>
  <div class="match-body">
    <span class="locked-line w-4/5"></span>
  </div>
</li>

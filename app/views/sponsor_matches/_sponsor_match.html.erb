<%# locals: (sponsor_match:, read_only:) -%>
<%#
  A match as one compact row (R99): logo, name, the fit score with its tier, one reason line and at most three
  evidence chips; the rest of the evidence waits in Why it fits. The owner's actions sit small on the right; read_only
  (a public sample, R78) leaves them out.
%>
<% match = sponsor_match %>
<% reason = report_text(match_reason_line(match), read_only) %>
<% chips = match_evidence_chips(match, read_only) %>
<article id="<%= dom_id(match) %>" class="match-row" aria-labelledby="<%= dom_id(match, :name) %>">
  <div class="match-logo"><%= render "sponsor_matches/logo", sponsor_match: match, size: "size-11 text-sm" %></div>
  <div class="match-head">
    <h3 id="<%= dom_id(match, :name) %>" class="match-name"><%= match.name %></h3>
    <% if match.category.present? %>
      <p class="match-category"><%= category_label(match.category) %></p>
    <% end %>
  </div>
  <div class="match-fit">
    <% if match.fit_score %>
      <p class="match-fit-score"><%= match.fit_score %><span class="match-fit-label"> fit</span></p>
    <% end %>
    <%= tier_badge(match.tier) %>
  </div>
  <div class="match-body">
    <% if reason %>
      <p class="match-reason" data-match-reason><%= reason %></p>
    <% end %>
    <div class="match-evidence">
      <% if chips.any? %>
        <ul class="match-chips" aria-label="Evidence">
          <% chips.each do |chip| %>
            <%# One inner span: in the inline-flex chip, loose text runs would lose their edge spaces. %>
            <li class="chip"><span><%= chip %></span></li>
          <% end %>
        </ul>
      <% end %>
      <%= render "sponsor_matches/why", sponsor_match: match, read_only: read_only %>
    </div>
  </div>
  <% unless read_only %>
    <div class="match-actions">
      <%= render "sponsor_matches/actions", sponsor_match: match %>
    </div>
  <% end %>
</article>

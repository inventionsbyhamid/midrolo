<% content_for :title, "Sign in" %>
<% content_for :meta, social_meta(description: "Sign in to Midrolo with Google to list your podcast or find podcasts for your brand.") %>
<%# Where you were going, said plainly as the title (G-3); Devise's red "sign in first" alert stays out when this says it. The view
    renders before the layout, so the flash is gone by the time the layout draws it. %>
<% context = sign_in_context %>
<% flash.delete(:alert) if sign_in_unauthenticated_alert? %>
<section class="wrap flex justify-center py-16 sm:py-24">
  <div class="w-full max-w-md">
    <%= render "components/card", title: context || "Sign in to #{APP_NAME}", heading: :h1 do %>
      <p class="mb-6 text-ink-soft">One click and you're in. We never post to your account.</p>
      <% if AuthConfig.developer_strategy? %>
        <%# Development without Google keys (R101): the developer strategy's callback takes a name and an email
            straight from this form, so OmniAuth's own unstyled form is never shown. %>
        <div class="flex flex-col gap-4 rounded-control border border-dashed border-line-strong p-4" data-dev-sign-in>
          <div>
            <h2 class="font-semibold">Dev sign in</h2>
            <p class="text-sm text-ink-soft">Development only, with no Google keys set. Any name and email will do.</p>
            <%# bin/setup's demo data (DemoSeed) makes this account an admin. %>
            <% if DemoSeed.admin_ready? %>
              <p class="text-sm text-ink-soft" data-dev-admin>Use <strong><%= DemoSeed::ADMIN_EMAIL %></strong> to be an admin.</p>
            <% end %>
          </div>
          <%= form_with url: ApplicationHelper::DEV_SIGN_IN_PATH, method: :post, local: true, data: { turbo: false },
                        class: "flex flex-col gap-3" do %>
            <div>
              <%= label_tag :dev_name, "Name", class: "label" %>
              <%= text_field_tag :name, nil, id: "dev_name", class: "input", autocomplete: "name", required: true %>
            </div>
            <div>
              <%= label_tag :dev_email, "Email", class: "label" %>
              <%= email_field_tag :email, nil, id: "dev_email", class: "input", autocomplete: "email", required: true %>
            </div>
            <%= submit_tag "Sign in", name: nil, class: "btn btn-primary btn-lg w-full" %>
          <% end %>
        </div>
      <% else %>
        <%= button_to "Continue with Google", user_google_oauth2_omniauth_authorize_path,
              method: :post, data: { turbo: false }, class: "btn btn-primary btn-lg w-full" %>
      <% end %>
      <p class="mt-4 text-sm text-ink-soft">
        By signing in you agree to our <%= link_to "Terms", terms_path, class: "link" %> and
        <%= link_to "Privacy policy", privacy_path, class: "link" %>.
      </p>
    <% end %>
  </div>
</section>

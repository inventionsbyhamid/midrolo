<% content_for :title, "Account" %>
<div class="flex flex-col gap-6">
  <header class="flex items-center gap-4">
    <%= render "accounts/avatar", user: current_user %>
    <div>
      <h1 class="type-h2"><%= current_user.name.presence || "Your account" %></h1>
      <p class="text-ink-soft"><%= current_user.email %></p>
    </div>
  </header>

  <%= render "components/card", title: "Plan", aside: ui_badge(current_plan.name, tone: current_plan.key == :free ? :neutral : :accent) do %>
    <p class="text-ink-soft"><%= plan_summary(current_plan) %></p>
    <% if (renewal = renewal_line(current_plan.subscription)) %>
      <p class="mt-2 text-ink-soft"><%= renewal %></p>
    <% end %>
    <% if current_plan.key == :free %>
      <%= ui_button "See plans", pricing_path, variant: :secondary, class: "mt-4" %>
    <% end %>
  <% end %>

  <%= render "components/card", title: "Usage" do %>
    <ul class="flex flex-col gap-2" aria-label="Usage">
      <% %i[agent snapshot pitch].each do |kind| %>
        <li><%= usage_line(current_plan, kind) %></li>
      <% end %>
    </ul>
  <% end %>

  <%= render "components/card", title: "Judge code" do %>
    <%= form_with url: judge_code_account_path, class: "flex flex-wrap items-end gap-3" do |f| %>
      <div class="flex flex-col gap-1">
        <%= f.label :code, "Code", class: "label" %>
        <%= f.text_field :code, class: "input", autocomplete: "off", required: true %>
      </div>
      <%= f.submit "Unlock", class: "btn btn-secondary btn-md" %>
    <% end %>
  <% end %>

  <%= render "components/card", title: "Billing" do %>
    <% if Billing.portal_subscription(current_user) %>
      <%= button_to "Manage billing", billing_portal_path, class: "btn btn-secondary btn-md", form: { data: { turbo: false } } %>
    <% elsif current_plan.subscription %>
      <p class="text-ink-soft">Your plan is active. Billing management opens with paid plans.</p>
    <% end %>
    <% unless current_plan.subscription %>
      <ul class="flex flex-col divide-y divide-line" aria-label="Plans">
        <% Billing.prices.each do |price| %>
          <li class="flex flex-wrap items-center justify-between gap-3 py-3">
            <span><strong><%= price_plan_name(price) %></strong> <span class="text-ink-soft"><%= price_label(price) %></span></span>
            <%= render "billing/plan_button", price_key: price.key, note: false %>
          </li>
        <% end %>
      </ul>
      <%= test_payments_note %>
    <% end %>
  <% end %>

  <%= render "components/card", title: "Sign out" do %>
    <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "btn btn-secondary btn-md" %>
  <% end %>

  <%= render "components/card", title: "Delete account" do %>
    <p class="mb-4 text-ink-soft">This permanently deletes your account and everything in it.</p>
    <% if current_user.renewing_subscription? %>
      <p class="mb-4 text-ink-soft"><%= AccountsController::CANCEL_FIRST %></p>
      <% if Billing.portal_subscription(current_user) %>
        <%= button_to "Manage billing", billing_portal_path, class: "btn btn-secondary btn-md", form: { data: { turbo: false } } %>
      <% end %>
    <% else %>
      <div data-controller="dialog">
        <%= ui_button "Delete account", type: "button", variant: :danger, data: { action: "dialog#open" } %>
        <%= render "components/dialog", title: "Delete your account?" do %>
          <p class="mb-6 text-ink-soft">This can't be undone. Your data is removed immediately.</p>
          <div class="flex gap-3">
            <%= button_to "Yes, delete everything", account_path, method: :delete, class: "btn btn-danger btn-md" %>
            <%= ui_button "Keep my account", type: "button", variant: :ghost, data: { action: "dialog#close" } %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>

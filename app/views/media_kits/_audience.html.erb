<%# locals: (content:) -%>
<%#
  Who listens, as on the report (R99): the top tastes as a few grouped chips, every list behind See all tastes, the
  age and gender leans in one compact block, and a small map with its top places in words. Hidden brands stay out
  of all of it. No scores: a kit never shows them. Print shows every list without JS (media_kits/_all_tastes).
%>
<% leans = content.demographics %>
<% heatmap = content.heatmap %>
<% points = heatmap ? heatmap_points(heatmap) : [] %>
<% groups = content.taste_groups %>
<section class="kit-section" aria-labelledby="kit-audience-title">
  <h2 id="kit-audience-title" class="kit-h2">Who listens</h2>
  <p class="kit-note">What people with this audience's tastes love, modeled from Qloo taste data.</p>

  <% if groups.any? %>
    <div class="kit-block kit-tastes">
      <%= render "reports/taste_chips", groups: top_tastes(groups) %>
      <details class="taste-more kit-more">
        <summary class="disclosure"><span>See all tastes</span></summary>
        <%= render "media_kits/all_tastes", content: content %>
      </details>
      <div class="kit-print-tastes"><%= render "media_kits/all_tastes", content: content %></div>
    </div>
  <% end %>

  <% if leans %>
    <div class="kit-block kit-keep">
      <h3 class="kit-h3">Age and gender</h3>
      <%= render "reports/lean_groups", demographics: leans %>
    </div>
  <% end %>

  <% if points.any? %>
    <div class="kit-block kit-map">
      <h3 class="kit-h3">Where they live<% if (place = heatmap_place(heatmap)) %><span class="kit-h3-aside"><%= place %></span><% end %></h3>
      <%= render "reports/heatmap", id: "kit_heatmap", heatmap: heatmap, points: points %>
      <p class="kit-note">Modeled from Qloo taste data. Useful for regional and local sponsors.</p>
    </div>
  <% end %>
</section>

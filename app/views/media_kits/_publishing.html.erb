<%# locals: (show:, kit:) -%>
<%# Publishing needs a verified show (the claim); the controls live here, outside the kit form. A published listing is
    the Rates section of the podcast's page (/k/:slug redirects there). %>
<%= render "components/card", title: "Your listing", aside: (show.public_kit? ? ui_badge("Published", tone: :success) : ui_badge(show.verified? ? "Not published" : "Draft")) do %>
  <% case show.claim_status %>
  <% when :managed_elsewhere %>
    <p class="font-semibold">Another account manages this show, so this listing stays a draft.</p>
    <p class="mt-1 text-ink-soft">If you work on the show, ask the owner for access. Your preview works either way.</p>
    <%= ui_button "Ask for access", new_podcast_claim_path(show.podcast), class: "mt-4" %>
  <% when :draft %>
    <p class="font-semibold"><%= MediaKit::VERIFY_TO_PUBLISH %></p>
    <p class="mt-1 text-ink-soft">Set everything up now. We'll email a code to the owner address in your RSS feed, or check for a short line you add to your show description. Your preview works either way.</p>
    <%= ui_button "Verify ownership", new_show_verification_path(show), class: "mt-4" %>
  <% else %>
    <% if show.public_kit? %>
      <div class="flex flex-col gap-3" data-controller="clipboard">
        <p>Your rates are live on your show's page: <%= link_to listing_podcast_url(show.podcast, anchor: "rates"), listing_podcast_path(show.podcast, anchor: "rates"), class: "link break-all", data: { clipboard_target: "source" } %></p>
        <p class="text-sm text-ink-soft"><%= kit.open_to_sponsors? ? "Brands can find you under Open to sponsors and request a spot." : "You're not marked open to sponsors, so the directory's Open to sponsors filter leaves you out." %></p>
        <div class="flex flex-wrap gap-3">
          <button type="button" class="btn btn-secondary btn-md" data-action="clipboard#copy">
            <span data-clipboard-target="label" aria-live="polite">Copy link</span>
          </button>
          <%= button_to "Unpublish", unpublish_show_media_kit_path(show), method: :patch, class: "btn btn-ghost btn-md" %>
        </div>
      </div>
    <% else %>
      <p>You've verified this show. Publish to put your rates, open months and who you're looking for on <span class="font-semibold break-all"><%= listing_podcast_url(show.podcast) %></span>.</p>
      <%= button_to "Publish listing", publish_show_media_kit_path(show), method: :patch, class: "btn btn-primary btn-md mt-4" %>
    <% end %>
  <% end %>
<% end %>

<%# locals: (show:, kit:, content:) -%>
<% suggested = content.suggested_rates %>
<% brands = content.brands(include_hidden: true) %>
<%= form_with model: kit, url: show_media_kit_path(show), method: :patch, class: "flex flex-col gap-6" do |f| %>
  <%# The form's default button, so Enter in a field saves rather than pressing the owner-address helper below. %>
  <button type="submit" class="sr-only" tabindex="-1" aria-hidden="true">Save</button>

  <% if kit.errors.any? %>
    <div class="flash flash-alert" role="alert">
      <ul><% kit.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
    </div>
  <% end %>

  <%= render "components/card", title: "Your story" do %>
    <div class="flex flex-col gap-6">
      <div>
        <%= f.label :headline, "Headline", class: "label" %>
        <%= f.text_field :headline, class: "input", maxlength: MediaKit::HEADLINE_LIMIT, aria: { describedby: "headline-help" } %>
        <p id="headline-help" class="hint">One line under your show's name: who it's for and why they listen.</p>
      </div>
      <div>
        <%= f.label :about, "About the show", class: "label" %>
        <%= f.text_area :about, class: "input min-h-40", rows: 6, maxlength: MediaKit::ABOUT_LIMIT,
              placeholder: show.description.to_s.truncate(160).presence, aria: { describedby: "about-help" } %>
        <p id="about-help" class="hint">Leave blank to use your feed's description.</p>
      </div>
    </div>
  <% end %>

  <%= render "components/card", title: "Photos" do %>
    <div class="grid gap-6 sm:grid-cols-2">
      <% { cover: [ "Cover", "A wide image across the top of your kit." ], host_photo: [ "Host photo", "A photo of you, shown beside your story." ] }.each do |name, (label, help)| %>
        <div class="min-w-0">
          <%= f.label name, label, class: "label" %>
          <% if (current = kit_image_url(kit.public_send(name), name == :cover ? :hero : :portrait)) %>
            <img src="<%= current %>" alt="Your current <%= label.downcase %>" class="<%= class_names("kit-thumb", "kit-thumb-wide" => name == :cover) %>">
          <% end %>
          <%= f.file_field name, accept: MediaKit::IMAGE_TYPES.join(","), class: "input kit-file",
                aria: { describedby: "#{name}-help", invalid: kit.errors.key?(name).presence } %>
          <p id="<%= name %>-help" class="hint"><%= help %> JPEG, PNG or WebP, up to 5 MB.</p>
          <% if kit.public_send(name).attached? && kit.public_send(name).blob.persisted? %>
            <label class="mt-2 flex items-center gap-2 text-sm">
              <%= f.check_box :"remove_#{name}" %> Remove this <%= label.downcase %>
            </label>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= render "components/card", title: "Contact" do %>
    <%= f.fields_for :show, show, include_id: false do |s| %>
      <%= s.label :contact_email, "Contact email", class: "label" %>
      <%= s.email_field :contact_email, class: "input", autocomplete: "email",
            aria: { describedby: "contact-help", invalid: kit.errors.key?(:"show.contact_email").presence } %>
    <% end %>
    <p id="contact-help" class="hint">
      Brands reach you here from the kit's "Work with us" button.
      <%= content.website ? "Leave blank to link your website instead." : "Leave blank to leave the button off." %>
    </p>
    <% if show.verified? && show.owner_email.present? && show.contact_email != show.owner_email %>
      <button type="submit" name="use_owner_email" value="1" class="link-button mt-3">
        Use my feed's owner address (<%= Shows::OwnerEmail.mask(show.owner_email) %>)
      </button>
    <% end %>
  <% end %>

  <%= render "components/card", title: "Rates" do %>
    <p class="text-ink-soft">Leave a rate blank to use our suggestion. The bundle price follows your midroll rate.</p>
    <div class="mt-4 grid gap-4 sm:grid-cols-3">
      <% MediaKit::RATE_SLOTS.each do |slot, label| %>
        <% field_id = "media_kit_rate_card_overrides_#{slot}" %>
        <div>
          <label for="<%= field_id %>" class="label"><%= label %> ($)</label>
          <%= number_field_tag "media_kit[rate_card_overrides][#{slot}]", kit.rate_card_overrides[slot], id: field_id, class: "input",
                placeholder: suggested.public_send(slot), min: 0, step: 1, inputmode: "numeric",
                aria: { describedby: "rates-basis", invalid: kit.errors.key?(:"#{slot}_rate").presence } %>
        </div>
      <% end %>
    </div>
    <p id="rates-basis" class="hint">Our suggestion: <%= suggested.basis %>.</p>
    <% unless show.downloads_per_episode %>
      <p class="hint"><%= link_to "Add your downloads per episode", edit_show_path(show), class: "link" %> for a sharper suggestion.</p>
    <% end %>
  <% end %>

  <% if brands.any? %>
    <%= render "components/card", title: "Brands on your kit" do %>
      <fieldset>
        <legend class="text-ink-soft">Your audience loves these brands. Tick any you'd rather not show, such as a competitor.</legend>
        <%= hidden_field_tag "media_kit[hidden_brand_ids][]", "", id: nil %>
        <ul class="mt-4 grid gap-x-6 sm:grid-cols-2">
          <% brands.each do |brand| %>
            <% box_id = "hide_brand_#{brand['id'].to_s.parameterize}" %>
            <li class="kit-hide-brand">
              <%= check_box_tag "media_kit[hidden_brand_ids][]", brand["id"], kit.hidden_brand_ids.include?(brand["id"].to_s), id: box_id %>
              <label for="<%= box_id %>"><span class="sr-only">Hide </span><%= brand["name"] %></label>
            </li>
          <% end %>
        </ul>
      </fieldset>
    <% end %>
  <% end %>

  <div class="flex flex-wrap items-center gap-3">
    <%= f.submit "Save kit", class: "btn btn-primary btn-lg" %>
    <%= ui_button "Preview", show_media_kit_path(show), variant: :ghost, size: :lg %>
  </div>
<% end %>

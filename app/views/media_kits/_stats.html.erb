<%# locals: (content:) -%>
<% stats = kit_stats(content) %>
<% if stats.any? %>
  <section class="kit-section kit-keep" aria-label="Show stats">
    <dl class="kit-stats">
      <% stats.each do |value, label| %>
        <div class="kit-stat">
          <dt class="kit-stat-label"><%= label %></dt>
          <dd class="kit-stat-value"><%= value %></dd>
        </div>
      <% end %>
    </dl>
    <%# Say where each number comes from (review PO-10): episodes and cadence are the feed's; downloads are the show's word. %>
    <p class="kit-note mt-4">
      <%= content.show.downloads_per_episode ? "Downloads per episode as reported by the show. Episodes and schedule from its RSS feed." : "From the show's RSS feed." %>
    </p>
  </section>
<% end %>

<%# locals: (content:, preview: false) -%>
<%# "Work with us": the contact email the owner chose, else the show's website. Never the feed's owner address.
    The address shows as text too, for print and for brands who copy it rather than click. With neither, the public
    kit leaves the section out and the owner's preview asks for a contact email instead (R54a). %>
<% email = content.contact_email %>
<% website = content.website %>
<% if email || website %>
  <section class="kit-section kit-contact kit-keep" aria-labelledby="kit-contact-title">
    <div class="min-w-0">
      <h2 id="kit-contact-title" class="kit-h2">Work with us</h2>
      <p class="kit-contact-lead">Tell us about your brand and the dates you have in mind.</p>
      <p class="kit-contact-address"><%= email || display_host(website) %></p>
    </div>
    <% if email %>
      <%= mail_to email, "Email us", subject: "Sponsoring #{content.show.title}", class: "btn btn-lg kit-contact-button" %>
    <% elsif content.show.public_kit? %>
      <%# A listed show takes requests on Midrolo, which keeps them in one inbox (review PO-10). %>
      <div class="flex flex-col items-start gap-2">
        <%= link_to "Request a spot on #{APP_NAME}", new_conversation_url(podcast: content.show.podcast.slug), class: "btn btn-lg kit-contact-button" %>
        <%= link_to "Or visit #{display_host(website)}", website, class: "text-sm text-surface underline underline-offset-4", rel: "noopener" %>
      </div>
    <% else %>
      <%= link_to "Visit our website", website, class: "btn btn-lg kit-contact-button", rel: "noopener" %>
    <% end %>
  </section>
<% elsif preview %>
  <section class="kit-section kit-screen-only" aria-label="Contact">
    <p class="kit-contact-missing">
      <%= link_to "Add a contact email so brands can reach you",
            edit_show_media_kit_path(content.show, anchor: "media_kit_show_attributes_contact_email"), class: "link" %>
    </p>
  </section>
<% end %>

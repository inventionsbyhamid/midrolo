<% content_for :title, "Saved shows" %>
<div class="flex flex-col gap-6">
  <header class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <p class="text-sm font-semibold text-plum"><%= current_brand.name %></p>
      <h1 class="type-h1">Saved shows</h1>
      <% if @saved.any? %><p class="mt-1 text-ink-soft">Your shortlist, with each show's fit, price and where your request stands.</p><% end %>
    </div>
    <%= ui_button "Find podcasts", new_brand_search_path, variant: :secondary %>
  </header>
  <% if @saved.any? %>
    <ul class="flex flex-col gap-3">
      <% @saved.each do |saved| %>
        <% podcast = saved.podcast %>
        <% fit = @fits[podcast.id] %>
        <% conversation = @requests[podcast.id] %>
        <li class="saved-row">
          <%= podcast_artwork_tag(podcast, size: :thumb, class: "size-16 flex-none") %>
          <div class="saved-row-main">
            <%= link_to podcast.title, brand_podcast_href(podcast), class: "result-title result-link", title: podcast.title %>
            <p class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
              <% if fit %><span class="font-semibold text-plum"><%= FitSearch::Scoring.fit_word(fit.score) %> <span class="tabular-nums"><%= fit.score %></span></span><% end %>
              <span><%= brand_price_text(podcast) || (podcast.claimed? ? "No rates yet" : "Hasn't joined #{APP_NAME} yet") %></span>
              <% if (downloads = brand_downloads_text(podcast)) %>
                <span class="flex items-center gap-2"><%= downloads %><%= trust_badge(podcast.downloads_trust) if podcast.downloads_trust.present? %></span>
              <% end %>
              <% if (months = brand_open_months_text(podcast)) %><span><%= months %></span><% end %>
            </p>
            <p class="flex flex-wrap items-center gap-2 text-sm text-ink-soft">
              <% if conversation %>
                <%= inbox_status_badge(conversation) %> <span>Asked <%= inbox_time(conversation.created_at) %></span>
              <% else %>
                <span>Saved <%= time_ago_in_words(saved.created_at) %> ago. Not asked yet.</span>
              <% end %>
            </p>
          </div>
          <div class="saved-row-actions">
            <% if conversation %>
              <%= ui_button "Open your request", conversation_path(conversation), size: :sm, variant: :secondary %>
            <% else %>
              <%= ui_button podcast.claimed? ? "Request a spot" : "Ask anyway", brand_podcast_href(podcast, anchor: "request"), size: :sm,
                    variant: podcast.claimed? ? :primary : :secondary %>
            <% end %>
            <%= render "podcasts/save", podcast: podcast, saved: true %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <%= render "components/empty_state", title: "Nothing saved yet", body: "Save shows from your search results to build a shortlist.",
          action_label: "Find podcasts", action_href: new_brand_search_path %>
  <% end %>
</div>

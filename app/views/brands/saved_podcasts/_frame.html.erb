<%# locals: (podcast:, saved:) -%>
<%# The Save button in its frame. saved: true, false, or nil for a user who isn't on a brand yet. %>
<%= turbo_frame_tag dom_id(podcast, :save), class: "contents" do %>
  <% if saved.nil? %>
    <%= link_to "Save", brand_start_path, class: "btn btn-secondary btn-sm", data: { turbo_frame: "_top" } %>
  <% elsif saved %>
    <%= button_to brand_saved_podcast_path(podcast.public_id), method: :delete, class: "btn btn-secondary btn-sm",
          aria: { label: "Saved. Remove #{podcast.title} from your shortlist" } do %>
      <svg viewBox="0 0 16 16" class="size-3.5" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Saved
    <% end %>
  <% else %>
    <%= button_to "Save", brand_saved_podcasts_path, params: { podcast_id: podcast.public_id }, class: "btn btn-secondary btn-sm",
          aria: { label: "Save #{podcast.title} to your shortlist" } %>
  <% end %>
<% end %>

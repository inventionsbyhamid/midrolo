<% content_for :title, "Podcasts for #{@search.query}" %>
<% content_for :head, turbo_refreshes_with(method: :morph, scroll: :preserve) %>
<%= turbo_stream_from @search %>
<div class="flex flex-col gap-6">
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div class="min-w-0">
      <p class="text-sm font-semibold text-plum">Fit search</p>
      <h1 class="type-h1 break-words">Podcasts for <%= @search.query %></h1>
      <p class="mt-2 flex flex-wrap items-center gap-2 text-sm text-ink-soft" aria-live="polite">
        <%= brand_search_status_badge(@search) %>
        <% if @search.categories.any? %><span class="chip"><%= Copy.and_list(@search.categories) %></span><% end %>
        <% if @search.budget_cents %><span class="chip">Budget <%= number_to_currency(@search.budget_cents / 100, precision: 0) %> per episode</span><% end %>
      </p>
    </div>
    <%= ui_button "New search", new_brand_search_path, variant: :secondary %>
  </header>

  <% if @search.active? %>
    <%= render "brands/searches/live", search: @search %>
  <% elsif @search.failed? %>
    <%= render "components/card", title: "This search didn't finish" do %>
      <p><%= @search.error_message.presence || FitSearch::Run::FAILURE_MESSAGE %></p>
      <div class="mt-3 flex flex-wrap items-center gap-3">
        <%= button_to "Run it again", brand_searches_path, params: { fit_search: @search.rerun_params },
              class: "btn btn-primary btn-md", form_class: "contents" %>
        <%= ui_button "Change the search", new_brand_search_path, variant: :secondary %>
      </div>
    <% end %>
    <%= render "brands/searches/how_found", search: @search %>
  <% else %>
    <%= render "brands/searches/how_found", search: @search %>

    <% if @results.empty? %>
      <%= render "brands/searches/no_matches", search: @search %>
    <% else %>
      <% common = brand_common_proof(@results) %>
      <% bullets = brand_summary_bullets(@search) %>
      <% if bullets.any? || common.any? %>
        <%= render "components/card", title: "At a glance", aside: ui_badge("Taste data from Qloo", tone: :accent) do %>
          <ul class="glance-list" data-summary>
            <% bullets.each do |bullet| %><li><%= bullet %></li><% end %>
            <% common.each do |row, shows| %>
              <li class="glance-proof" data-common-proof><%= brand_common_proof_line(row, shows) %>.</li>
            <% end %>
          </ul>
        <% end %>
      <% end %>

      <section aria-labelledby="results-heading" class="flex flex-col gap-8">
        <h2 id="results-heading" class="sr-only"><%= pluralize(@results.size, "show") %> ranked for you</h2>
        <% brand_result_groups(@results).each do |key, heading, note, results| %>
          <section class="result-group" aria-labelledby="group-<%= key %>" data-group="<%= key %>">
            <header class="result-group-head">
              <h3 id="group-<%= key %>" class="type-h3"><%= heading %> <span class="result-group-count"><%= results.size %></span></h3>
              <p class="text-sm text-ink-soft"><%= note %></p>
            </header>
            <% shown, more = key == "ready" ? [ results, [] ] : [ results.first(BrandWorkspaceHelper::RESULTS_SHOWN), results.drop(BrandWorkspaceHelper::RESULTS_SHOWN) ] %>
            <ol class="result-list">
              <% shown.each do |result| %>
                <%= render "brands/searches/result", result: result, saved: @saved_ids.include?(result.podcast_id),
                      common: common, featured: key == "ready" %>
              <% end %>
            </ol>
            <% if more.any? %>
              <details class="result-more">
                <summary class="btn btn-secondary btn-sm">Show <%= more.size %> more</summary>
                <ol class="result-list mt-3">
                  <% more.each do |result| %>
                    <%= render "brands/searches/result", result: result, saved: @saved_ids.include?(result.podcast_id),
                          common: common, featured: false %>
                  <% end %>
                </ol>
              </details>
            <% end %>
          </section>
        <% end %>
      </section>
    <% end %>
  <% end %>
</div>

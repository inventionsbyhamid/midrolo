<%# locals: (result:, saved:, common: [], featured: false) -%>
<%#
  One ranked show (review BR-8). A featured row (ready to book) shows why it fits and its proof up front with Request a
  spot as the primary action; the rest are compact rows with their reasons behind "Why it fits" and "Ask anyway".
  Proof every result shares (common) is said once above the list, so a card keeps only its own.
%>
<% podcast = result.podcast %>
<% proof = brand_own_proof(result, common) %>
<% tier = brand_result_tier(result) %>
<% bookable = podcast.claimed? && tier != "dormant" %>
<li id="<%= dom_id(podcast, :result) %>" class="<%= class_names("result", "result-featured" => featured) %>"
    aria-labelledby="<%= dom_id(podcast, :result_title) %>" data-tier="<%= tier %>">
  <%= podcast_artwork_tag(podcast, size: :card, class: "result-art") %>
  <div class="result-main">
    <div class="result-head">
      <div class="min-w-0">
        <p class="result-rank">#<%= result.position %><% if (note = brand_tier_note(result)) %> <span class="<%= class_names("result-tier", "result-tier-#{tier}") %>"><%= note %></span><% end %></p>
        <h4 id="<%= dom_id(podcast, :result_title) %>" class="result-title" title="<%= podcast.title %>">
          <%= link_to podcast.title, brand_podcast_href(podcast), class: "result-link" %>
        </h4>
        <% if podcast.author.present? %><p class="result-by"><%= podcast.author %></p><% end %>
        <% if podcast.pending? %><p class="mt-1"><%= ui_badge "Being added to the catalog", tone: :accent %></p><% end %>
      </div>
      <p class="result-fit" data-fit-score="<%= result.score %>">
        <span class="result-fit-value"><%= result.score %></span>
        <span class="result-fit-word"><%= brand_fit_word(result) %></span>
      </p>
    </div>

    <% price = brand_price_text(podcast) %>
    <% downloads = brand_downloads_text(podcast) %>
    <% months = brand_open_months_text(podcast) %>
    <%# A show that hasn't joined has no rate card by definition; its group says so once. %>
    <% if price || downloads || months || podcast.claimed? %>
    <dl class="result-facts">
      <div>
        <dt class="sr-only">Price</dt>
        <dd>
          <% if price %><span><%= price %></span><% end %>
          <%= brand_price_fit_badge(result.price_fit) %>
        </dd>
      </div>
      <% if downloads %>
        <div>
          <dt class="sr-only">Audience</dt>
          <dd><span><%= downloads %></span><%= trust_badge(podcast.downloads_trust) if podcast.downloads_trust.present? %></dd>
        </div>
      <% end %>
      <% if months %>
        <div><dt class="sr-only">Open months</dt><dd><%= months %></dd></div>
      <% end %>
    </dl>
    <% end %>

    <% if featured && result.reasons.any? %>
      <ul class="result-reasons" data-reasons>
        <% result.reasons.each do |reason| %><li><%= reason %></li><% end %>
      </ul>
    <% end %>
    <% if proof.any? %>
      <ul class="result-proof" data-proof>
        <% proof.each do |row| %>
          <li>
            <svg viewBox="0 0 16 16" class="mt-0.5 size-4 flex-none text-success" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span><%= brand_proof_line(row) %></span>
          </li>
        <% end %>
      </ul>
    <% end %>

    <div class="result-actions">
      <% if bookable %>
        <%= ui_button "Request a spot", brand_podcast_href(podcast, anchor: "request"), size: :sm, variant: featured ? :primary : :secondary %>
      <% else %>
        <%= ui_button "Ask anyway", brand_podcast_href(podcast, anchor: "request"), size: :sm, variant: :ghost, class: "result-ask" %>
      <% end %>
      <%= render "podcasts/save", podcast: podcast, saved: saved %>
      <details class="result-why">
        <summary><%= featured ? "Score breakdown" : "Why it fits" %></summary>
        <div class="result-why-body">
          <% unless featured %>
            <ul class="result-reasons" data-reasons>
              <% result.reasons.each do |reason| %><li><%= reason %></li><% end %>
            </ul>
          <% end %>
          <ul class="result-parts">
            <% brand_score_parts(result).each do |label, points, weight| %>
              <li><%= label %> <span class="tabular-nums"><%= points %> of <%= weight %></span></li>
            <% end %>
          </ul>
        </div>
      </details>
    </div>
  </div>
</li>

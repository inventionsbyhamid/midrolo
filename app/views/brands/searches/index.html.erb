<% content_for :title, "Your searches" %>
<div class="flex flex-col gap-6">
  <header class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="type-h1">Your searches</h1>
    <%= ui_button "New search", new_brand_search_path %>
  </header>
  <% if @searches.any? %>
    <%= render "brands/searches/list", searches: @searches, result_counts: @result_counts %>
  <% else %>
    <%= render "components/empty_state", title: "No searches yet", body: "Run a search to see which podcasts your customers love.",
          action_label: "Find podcasts", action_href: new_brand_search_path %>
  <% end %>
</div>

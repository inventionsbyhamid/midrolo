<%# locals: (show:, verification:) -%>
<%= render "components/card", title: "Check your inbox" do %>
  <p>We sent a 6-digit code to <%= verification.masked_sent_to %>. It works for 30 minutes.</p>
  <% if verification.locked? %>
    <p class="field-error"><%= ShowVerification::LOCKED_MESSAGE %></p>
  <% elsif verification.expired? %>
    <p class="field-error"><%= ShowVerification::EXPIRED_CODE_MESSAGE %></p>
  <% else %>
    <%= form_with url: show_verification_path(show), method: :patch, class: "mt-5 flex flex-wrap items-end gap-3" do |f| %>
      <div>
        <%= f.label :code, "6-digit code", class: "label" %>
        <%= f.text_field :code, class: "input verify-code", inputmode: "numeric", autocomplete: "one-time-code",
              maxlength: 7, required: true, autofocus: true, spellcheck: false,
              aria: { invalid: flash[:verify_note].present?.presence, describedby: ("code-error" if flash[:verify_note].present?) } %>
      </div>
      <%= f.submit "Verify", class: "btn btn-primary btn-lg" %>
    <% end %>
    <% if flash[:verify_note].present? %><p id="code-error" class="field-error" role="alert"><%= flash[:verify_note] %></p><% end %>
  <% end %>
  <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-line pt-4 text-sm">
    <span class="text-ink-soft">No email? Check your spam folder, or</span>
    <%= button_to "Send a new code", show_verification_path(show), params: { kind: "email" }, class: "link-button" %>
    <% if show.feed_url.present? %>
      <%= button_to "Use a feed token instead", show_verification_path(show), params: { kind: "feed_token" }, class: "link-button" %>
    <% end %>
  </div>
<% end %>

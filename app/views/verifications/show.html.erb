<% content_for :title, "Verify #{@show.title}" %>
<%# A feed token is checked again in the background after a miss (Verifications::WatchFeedJob), which refreshes this
    page when it verifies the show; the refresh lands on the verified page. %>
<% unless @verification.email? %>
  <% content_for :head, turbo_refreshes_with(method: :morph, scroll: :preserve) %>
  <%= turbo_stream_from ShowVerification.stream_name(@show) %>
<% end %>
<div class="mx-auto flex max-w-2xl flex-col gap-6">
  <%= render "verifications/header", show: @show %>
  <%= render(@verification.email? ? "verifications/code" : "verifications/token", show: @show, verification: @verification) %>
  <% unless @verification.email? %>
    <p class="text-sm"><%= link_to "Choose another way to verify", new_show_verification_path(@show), class: "link" %></p>
  <% end %>
</div>

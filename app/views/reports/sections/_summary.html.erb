<%# locals: (report:, read_only: false) -%>
<%# A finished Snapshot gets the upgrade card. Any other Snapshot (running, needs_input, failed) falls through, so a
    needs-input ask or a failure leads the page instead of an upsell (Review Focus #1). %>
<%# read_only (a public sample, R78) has no upgrade card: the run buttons belong to the show's owner. %>
<% if report.snapshot? && report.done? && !read_only %>
  <%= render "reports/section", name: "summary", title: "Your audience at a glance" do %>
    <% if report.summary.present? %>
      <p class="report-summary"><%= report.summary %></p>
    <% end %>
    <div class="upgrade-card">
      <p class="max-w-prose">This is your free Snapshot. Upgrade for the full agent report: reasons, proven sponsors, pitch emails.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <% if AppSettings.runs_paused? %>
          <%= ui_button "Run full report", type: "button", disabled: true %>
        <% else %>
          <%= button_to "Run full report", show_reports_path(report.show, kind: "agent"), method: :post, class: "btn btn-primary btn-md" %>
        <% end %>
        <%= ui_button "See plans", "/pricing", variant: :secondary %>
      </div>
    </div>
  <% end %>
<% elsif report.summary.present? %>
  <%= render "reports/section", name: "summary", title: "Your audience at a glance" do %>
    <p class="report-summary"><%= report.summary %></p>
  <% end %>
<% elsif section_pending?(report) %>
  <%= render "reports/section", name: "summary", title: "Your audience at a glance" do %>
    <%= render "components/skeleton", lines: 3, label: "Writing your summary", title: false %>
  <% end %>
<% else %>
  <%= render "reports/section", name: "summary", hidden: true %>
<% end %>

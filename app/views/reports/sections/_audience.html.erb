<%# locals: (report:, read_only:) -%>
<%#
  The audience as a few grouped chips with no scores (R99), and every list behind See all tastes, where each score
  reads as words. A Snapshot has only its interests.
%>
<% groups = audience_groups(report.audience) %>
<% listeners = report_listeners(read_only) %>
<% title = read_only ? "This show's audience" : "Your audience" %>
<% if groups.empty? %>
  <% if section_pending?(report) %>
    <%= render "reports/section", name: "audience", title: title do %>
      <%= render "components/skeleton", lines: 4, label: "Reading #{read_only ? "the" : "your"} audience", title: false %>
    <% end %>
  <% else %>
    <%= render "reports/section", name: "audience", hidden: true %>
  <% end %>
<% else %>
  <%= render "reports/section", name: "audience", title: title do %>
    <p class="report-section-note">What people with <%= listeners %>' tastes love more than most people do, from Qloo taste data.</p>
    <%= render "reports/taste_chips", groups: top_tastes(groups.map { |_, label, items| [ label, items.map { |item| item["name"] } ] }) %>
    <details class="taste-more">
      <summary class="disclosure"><span>See all tastes</span></summary>
      <p class="report-section-note mt-3">Each one says how much more this audience likes it than most people do.</p>
      <div class="taste-lists">
        <% groups.each do |key, label, items| %>
          <section class="taste-list-group" aria-labelledby="<%= dom_id(report, "#{key}_list") %>">
            <h3 id="<%= dom_id(report, "#{key}_list") %>" class="taste-list-title"><%= label %></h3>
            <ol class="taste-list">
              <% items.each do |item| %>
                <li>
                  <span class="taste-name" data-item-name><%= item["name"] %></span>
                  <% if (band = taste_band(key == "tags" ? item["score"] : item["affinity"])) %>
                    <span class="taste-band"><%= band %></span>
                  <% end %>
                </li>
              <% end %>
            </ol>
          </section>
        <% end %>
      </div>
    </details>
  <% end %>
<% end %>

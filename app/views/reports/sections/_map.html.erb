<%# locals: (report:, read_only:) -%>
<%# A small map and its top three places in words (R99), which stand alone if the map can't load. %>
<% heatmap = report.heatmap.is_a?(Hash) ? report.heatmap : nil %>
<% title = "Where they are" %>
<% if heatmap.nil? %>
  <% if section_pending?(report) %>
    <%= render "reports/section", name: "map", title: title do %>
      <%= render "components/skeleton", lines: 3, label: "Mapping #{report_listeners(read_only)}", title: false %>
    <% end %>
  <% else %>
    <%= render "reports/section", name: "map", hidden: true %>
  <% end %>
<% else %>
  <% points = heatmap_points(heatmap) %>
  <% place = heatmap_place(heatmap) %>
  <%= render "reports/section", name: "map", title: title, aside: (ui_badge(place, tone: :accent) if place) do %>
    <% if points.empty? %>
      <p class="mt-2 rounded-control border border-dashed border-line-strong px-4 py-6 text-ink-soft">Not enough location data for this audience</p>
    <% else %>
      <%= render "reports/heatmap", id: dom_id(report, :heatmap), heatmap: heatmap, points: points %>
    <% end %>
    <p class="report-section-note mt-3">Modeled from Qloo taste data. Handy for regional and local sponsors.</p>
  <% end %>
<% end %>

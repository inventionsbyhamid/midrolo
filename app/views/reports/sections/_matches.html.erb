<%# locals: (report:, read_only:) -%>
<%#
  Preloaded by ReportsController#show; Report#save_section! resets the association before a broadcast.
  The top 10 show as rows (R99). The rest wait behind Show all, a <details> that works without JS; its filters need
  JS, so the filter controller shows them only while the full list is open. Locked Snapshot matches come last and
  carry no brand data at all (R43).
%>
<% matches = report.sponsor_matches.to_a %>
<% if matches.empty? %>
  <% if section_pending?(report) %>
    <%= render "reports/section", name: "matches", title: "Sponsor matches" do %>
      <%= render "components/skeleton", lines: 4, label: "Ranking sponsors", title: false %>
    <% end %>
  <% elsif report.done? %>
    <%= render "reports/section", name: "matches", title: "Sponsor matches" do %>
      <% if read_only %>
        <%= render "components/empty_state", title: "No matches yet.",
              body: "None of the brands we checked fit this audience well enough to suggest." %>
      <% else %>
        <%= render "components/empty_state", title: "No matches yet.",
              body: "None of the brands we checked fit this audience well enough to suggest. Add a few comparable shows and run the report again.",
              action_label: "Add comparable shows", action_href: edit_show_path(report.show) %>
      <% end %>
    <% end %>
  <% else %>
    <%= render "reports/section", name: "matches", hidden: true %>
  <% end %>
<% else %>
  <% visible, locked = split_matches(report) %>
  <% top = visible.first(ReportsHelper::TOP_MATCHES) %>
  <% rest = visible.drop(ReportsHelper::TOP_MATCHES) %>
  <% list_ids = [ dom_id(report, :top_matches), dom_id(report, :more_matches) ] %>
  <%= render "reports/section", name: "matches", title: "Sponsor matches",
        aside: tag.p("#{pluralize(matches.size, 'brand')}, best fit first", class: "text-sm text-ink-soft") do %>
    <div data-controller="filter">
      <ol id="<%= list_ids.first %>" class="match-list" data-filter-target="list" aria-label="Top sponsor matches">
        <%= render partial: "sponsor_matches/list_item", collection: top, as: :sponsor_match, locals: { read_only: read_only } %>
      </ol>
      <% if rest.any? %>
        <details class="match-more" data-filter-target="more" data-action="toggle->filter#expanded">
          <summary class="disclosure match-more-summary">
            <span class="when-closed">Show all <%= visible.size %> matches</span>
            <span class="when-open">Show only the top <%= top.size %></span>
          </summary>
          <%= render "reports/match_filters", report: report, matches: visible, list_ids: list_ids %>
          <ol id="<%= list_ids.last %>" class="match-list" data-filter-target="list" aria-label="More sponsor matches">
            <%= render partial: "sponsor_matches/list_item", collection: rest, as: :sponsor_match, locals: { read_only: read_only } %>
          </ol>
        </details>
      <% end %>
      <div class="mt-4" data-filter-target="empty" hidden>
        <%= render "components/empty_state", title: "No matches fit these filters.", body: "Turn a filter off to see more brands." %>
      </div>
    </div>

    <% if locked.any? %>
      <div class="locked-matches">
        <ol class="match-list locked-list" aria-hidden="true" inert>
          <%= render partial: "sponsor_matches/locked", collection: locked.first(ReportsHelper::TOP_MATCHES), as: :sponsor_match %>
        </ol>
        <div class="locked-overlay">
          <div class="locked-cta">
            <%# Secondary: the page's one primary action is the next step in At a glance (R111). %>
            <%= link_to pricing_path, class: "btn btn-secondary btn-lg" do %>Unlock <%= pluralize(locked.size, "more match") %><% end %>
            <% tier_counts = locked_tier_counts(locked) %>
            <% if tier_counts.any? %>
              <p class="mt-3 text-[0.9375rem]">
                Includes <%= and_list(tier_counts.map { |label, count| "#{count} #{label.downcase}" }) %>
                <%= "brand".pluralize(tier_counts.sum(&:last)) %>, each with its reason and evidence.
              </p>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>

<%# locals: (report:, matches:, list_ids:) -%>
<%#
  One compact row of filters for the full match list (filter_controller): tier chips, proven sponsors, a category
  menu and the sort. Hidden until JS shows it with the full list, since none of it works without JS. Built from the
  visible matches only, so a locked brand's category never shows (R43).
%>
<% categories = matches.filter_map { |m| m.category.presence }.tally.sort_by { |name, count| [ -count, name ] }.map(&:first) %>
<% controls = list_ids.join(" ") %>
<div class="match-toolbar" data-filter-target="toolbar" role="group" aria-label="Filter and sort the matches" hidden>
  <% ReportsHelper::TIERS.each do |tier, (label, tone)| %>
    <button type="button" class="filter-chip" aria-pressed="false" aria-controls="<%= controls %>"
            data-filter-target="chip" data-group="tier" data-value="<%= tier %>" data-action="filter#toggle">
      <span class="filter-chip-dot filter-chip-dot-<%= tone %>" aria-hidden="true"></span><%= label %>
    </button>
  <% end %>
  <% if matches.any? { |m| proven_sponsor?(m) } %>
    <button type="button" class="filter-chip" aria-pressed="false" aria-controls="<%= controls %>"
            data-filter-target="chip" data-group="proven" data-value="true" data-action="filter#toggle">Proven sponsors</button>
  <% end %>
  <% if categories.size > 1 %>
    <label class="filter-select">
      <span class="sr-only">Category</span>
      <select class="input select-sm" data-filter-target="category" data-action="filter#apply" aria-controls="<%= controls %>">
        <option value="">All categories</option>
        <% categories.each do |category| %>
          <option value="<%= category %>"><%= category %></option>
        <% end %>
      </select>
    </label>
  <% end %>
  <label class="filter-select">
    <span class="sr-only">Sort</span>
    <select class="input select-sm" data-filter-target="sort" data-action="filter#sort" aria-controls="<%= controls %>">
      <option value="fit">Best fit</option>
      <option value="tier">Easiest to land</option>
    </select>
  </label>
  <p class="filter-status" data-filter-target="status" aria-live="polite">Showing <%= matches.size %> of <%= matches.size %></p>
  <button type="button" class="link text-sm" data-filter-target="clear" data-action="filter#clear" hidden>Clear filters</button>
</div>

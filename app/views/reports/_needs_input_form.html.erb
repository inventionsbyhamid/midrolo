<%# locals: (report:) -%>
<%# Fewer than 2 seeds (Review Focus #1): ask for comparable shows, save them as hints and re-run the same kind (R41). %>
<% show = report.show %>
<div class="needs-input mt-4" role="region" aria-labelledby="needs_input_title_<%= report.public_id %>">
  <p id="needs_input_title_<%= report.public_id %>" class="type-h3 max-w-prose">We need a little more to go on. Tell us 2 or 3 shows your listeners also love.</p>
  <% if report.unresolved_seeds.any? %>
    <p class="mt-2 text-[0.9375rem]">We couldn't find these on Qloo: <%= and_list(report.unresolved_seeds) %>. Try another spelling or a different show.</p>
  <% end %>

  <%= form_with model: show, url: show_path(show), method: :patch, class: "mt-5 flex flex-col gap-5" do |f| %>
    <%= hidden_field_tag :rerun, report.kind %>
    <%= hidden_field_tag :report_id, report.public_id %>
    <fieldset>
      <legend class="label">Shows your listeners also love</legend>
      <div class="grid gap-2 sm:grid-cols-2">
        <% Show::HINT_LIMIT.times do |i| %>
          <%= text_field_tag "show[hints][comparable_shows][]", show.hints[:comparable_shows][i],
                id: "rerun_comparable_show_#{i}", class: "input", maxlength: Show::HINT_LENGTH, autocomplete: "off",
                placeholder: (i.zero? ? "e.g. Acquired" : nil), required: i.zero?, aria: { label: "Comparable show #{i + 1}" } %>
        <% end %>
      </div>
    </fieldset>
    <fieldset>
      <legend class="label">Topics you cover <span class="font-normal text-ink-soft">(optional)</span></legend>
      <div class="grid gap-2 sm:grid-cols-2">
        <% Show::HINT_LIMIT.times do |i| %>
          <%= text_field_tag "show[hints][topics][]", show.hints[:topics][i],
                id: "rerun_topic_#{i}", class: "input", maxlength: Show::HINT_LENGTH, autocomplete: "off",
                placeholder: (i.zero? ? "e.g. personal finance" : nil), aria: { label: "Topic #{i + 1}" } %>
        <% end %>
      </div>
    </fieldset>
    <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
      <%= f.submit "Save and research again", class: "btn btn-primary btn-md" %>
      <%= link_to "Edit all show details", edit_show_path(show), class: "link text-[0.9375rem]" %>
    </div>
  <% end %>
</div>

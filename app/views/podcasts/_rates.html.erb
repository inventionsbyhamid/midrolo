<%# locals: (podcast:) -%>
<%# Podcast page: the published listing and rate card (lane L4), inside lane L3's Rates section (#rates; /k/:slug
    redirects here). Nothing until the owner show publishes, so L3's empty state shows. Reads only what Podcast.for_page
    preloads: the owner show with its kit and podcast, and the readings. %>
<% kit = podcast.published_listing %>
<% if kit %>
  <% content = MediaKit::Content.new(kit, podcast: podcast) %>
  <% rates = content.rates %>
  <% basis = content.downloads_basis %>
  <% months = kit.open_months.select { |month| month >= Date.current.strftime("%Y-%m") } %>
  <div class="listing-rates">
    <p class="flex flex-wrap items-center gap-2">
      <%= kit.open_to_sponsors? ? ui_badge("Open to sponsors", tone: :success) : ui_badge("Not taking sponsors right now") %>
      <%= listing_demo_badge(podcast) %>
    </p>

    <%# Each slot says whose price it is (PP-7): the show's own, or Midrolo's suggestion where the show set none. %>
    <% own = kit.rate_card_overrides.select { |_, figure| figure.is_a?(Integer) }.keys %>
    <% slots = [ [ "preroll", "Preroll", rates.preroll, "Before the episode starts" ], [ "midroll", "Midroll", rates.midroll, "Read by the host, midway through" ],
                 [ "postroll", "Postroll", rates.postroll, "After the episode ends" ] ] %>
    <dl class="listing-slots">
      <% slots.each do |key, name, price, note| %>
        <div class="<%= class_names("listing-slot", "listing-slot-mid" => key == "midroll") %>">
          <dt class="text-sm font-semibold"><%= name %></dt>
          <dd class="listing-slot-price"><%= kit_money(price) %></dd>
          <dd class="text-sm text-ink-soft"><%= note %></dd>
          <% if rates.custom? && !own.include?(key) %><dd><%= ui_badge "Suggested" %></dd><% end %>
        </div>
      <% end %>
    </dl>
    <p><%= kit_bundle_line(rates) %></p>
    <% set, suggested = slots.partition { |key, *| own.include?(key) }.map { |group| group.map { |_, name, *| name } } %>
    <p class="text-sm text-ink-soft">
      <% if !rates.custom? %>
        Suggested rates: <%= rates.basis %>.
      <% elsif suggested.empty? %>
        Rates set by the show.
      <% else %>
        <%= Copy.and_list(set).downcase.upcase_first %> set by the show; <%= Copy.and_list(suggested).downcase %> suggested by <%= APP_NAME %>.
      <% end %>
      Per episode, in US dollars.
    </p>
    <% if basis&.reading %>
      <p class="flex flex-wrap items-center gap-2 text-sm text-ink-soft">
        <span>Based on <%= listing_basis_figure(basis, bands: kit.bands_only?) %>.</span>
        <%= trust_badge(basis.reading) %>
      </p>
    <% end %>

    <% if months.any? || kit.looking_for.present? || kit.exclusions.any? %>
      <dl class="listing-facts">
        <% if months.any? %>
          <div>
            <dt>Open months</dt>
            <dd><ul class="flex flex-wrap gap-2"><% months.each do |month| %><li class="chip"><%= listing_month_label(month) %></li><% end %></ul></dd>
          </div>
        <% end %>
        <% if kit.looking_for.present? %>
          <div>
            <dt>Who we're looking for</dt>
            <dd class="whitespace-pre-line"><%= kit.looking_for %></dd>
          </div>
        <% end %>
        <% if kit.exclusions.any? %>
          <div>
            <dt>We don't advertise</dt>
            <dd><%= kit.exclusions.join(", ") %></dd>
          </div>
        <% end %>
      </dl>
    <% end %>
  </div>
<% end %>

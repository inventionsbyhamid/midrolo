<% content_for :meta, social_meta(description: "Midrolo is where independent podcasts get sponsored. Brands find shows their customers love with Qloo taste data, verified Spotify and Apple numbers and real sponsor history. Listing is free.") %>
<%= render "pages/home/hero", sample: @hero_sample, matches: @hero_matches %>
<%= render "pages/home/proof", facts: @catalog_facts %>
<%= render "pages/home/for_brands", showcase: @showcase, sponsors: @showcase_sponsors %>
<%= render "pages/home/for_podcasters", demo: @demo %>
<%= render "pages/home/quotes" %>
<%= render "pages/home/old_way" %>
<%= render "pages/home/creator_lab" %>
<%= render "pages/home/explore", samples: @samples, demo: @demo %>
<%# Pricing in one line (UX review L-1): the full plans live on /pricing, the sample reports on /samples (See it for
    yourself links both), and the landing keeps the marketplace questions. %>
<section id="pricing" class="page-section" aria-labelledby="pricing-title">
  <div class="wrap landing-pricing">
    <div>
      <h2 id="pricing-title" class="type-h2">Pricing</h2>
      <p class="section-lead">Free to list your show. Free for brands during the trial. No commission on any deal.</p>
    </div>
    <%= ui_button "See pricing", pricing_path, variant: :secondary, size: :lg %>
  </div>
</section>
<section id="faq" class="page-section" aria-labelledby="faq-title">
  <div class="wrap">
    <%= render "pages/faq", marketplace_only: true %>
  </div>
</section>
<%= render "pages/home/closing" %>

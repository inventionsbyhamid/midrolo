<%# The old way of finding sponsors against Midrolo's, row by row, six words a cell at most. On a phone each row
    stacks into labelled pairs. %>
<% rows = [
     [ "Choosing brands", "Guess from your topic", "Ranked by your listeners' taste" ],
     [ "Proving fit", "Downloads and countries, nothing on taste", "Shared taste and proven sponsors" ],
     [ "Pricing a spot", "A mysterious formula", "Editable rate card from published benchmarks" ],
     [ "Landing the deal", "Marketplaces that take a cut", "Pitch directly. No commission." ]
   ] %>
<section id="old-way" class="page-section" aria-labelledby="old-way-title">
  <div class="wrap">
    <h2 id="old-way-title" class="type-h2">The old way vs <%= APP_NAME %></h2>
    <%# Explicit roles keep it a table for screen readers when a phone's CSS stacks the cells (display: block). %>
    <table class="compare" role="table">
      <thead role="rowgroup">
        <tr role="row">
          <td role="cell"></td>
          <th scope="col" role="columnheader">The old way</th>
          <th scope="col" role="columnheader" class="compare-ours">With <%= APP_NAME %></th>
        </tr>
      </thead>
      <tbody role="rowgroup">
        <% rows.each do |topic, old, ours| %>
          <tr role="row">
            <th scope="row" role="rowheader"><%= topic %></th>
            <td role="cell" data-label="The old way"><%= old %></td>
            <td role="cell" data-label="With <%= APP_NAME %>" class="compare-ours"><%= ours %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>

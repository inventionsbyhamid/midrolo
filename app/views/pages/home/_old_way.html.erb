<%# The old way of podcast sponsorship against Midrolo's, row by row, six words a cell at most, from the research
    (research/research-marketplace.md: hidden rates, weeks of email, estimates that miss by half, marketplaces that take a
    cut). On a phone each row stacks into labelled pairs. %>
<% rows = [
     [ "Finding shows", "Spreadsheets and Reddit threads", "Ranked by your customers' taste" ],
     [ "Trusting the numbers", "Screenshots and estimates", "Verified with Spotify and Apple" ],
     [ "Proving fit", "Topic guesses", "Real sponsor history, with episodes" ],
     [ "Pricing a spot", "Rates hidden until you ask", "Rate cards on the page" ],
     [ "Booking", "Weeks of email, then a cut", "Request a spot. No commission." ]
   ] %>
<section id="old-way" class="page-section" aria-labelledby="old-way-title">
  <div class="wrap">
    <h2 id="old-way-title" class="type-h2">The old way vs <%= APP_NAME %></h2>
    <%# Explicit roles keep it a table for screen readers when a phone's CSS stacks the cells (display: block). %>
    <table class="compare" role="table">
      <thead role="rowgroup">
        <tr role="row">
          <td role="cell"></td>
          <th scope="col" role="columnheader">The old way</th>
          <th scope="col" role="columnheader" class="compare-ours">With <%= APP_NAME %></th>
        </tr>
      </thead>
      <tbody role="rowgroup">
        <% rows.each do |topic, old, ours| %>
          <tr role="row">
            <th scope="row" role="rowheader"><%= topic %></th>
            <td role="cell" data-label="The old way"><%= old %></td>
            <td role="cell" data-label="With <%= APP_NAME %>" class="compare-ours"><%= ours %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>

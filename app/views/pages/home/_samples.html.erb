<%# locals: (samples:, match_counts:) -%>
<%# Sample reports: real reports on public shows, open to anyone, after the podcaster side. Each card opens its
    sample; the free Snapshot (snapshot_start_path) is the section's call to action, /samples the rest. The cards are
    left out until bin/rails samples:generate has run, and the calls to action stay. %>
<section id="samples" class="page-section" aria-labelledby="samples-title">
  <div class="wrap">
    <h2 id="samples-title" class="type-h2">Sample reports</h2>
    <% if samples.any? %>
      <%= render "samples/list", samples: samples, match_counts: match_counts, heading: :h3 %>
    <% end %>
    <div class="hero-actions">
      <%= ui_button "Get a free Snapshot of your show", snapshot_start_path, size: :lg %>
      <%= ui_button "See all sample reports", samples_path, variant: :secondary, size: :lg %>
    </div>
  </div>
</section>

<%# locals: (sample:, matches:) -%>
<%# The hero: the Creator Lab news, the promise, one call to action for each side, and an episode waveform whose lit
    midroll slot holds a brand match. The match card is the first sample's real top matches (or an illustration until
    a sample is done). %>
<section id="hero" class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <%= link_to "#creator-lab", class: "hero-news" do %>
        <span class="hero-news-lamp" aria-hidden="true"></span>
        <span><%= landing_creator_lab_line %> <strong>List your show free.</strong></span>
      <% end %>
      <h1 id="hero-title" class="hero-title">Where independent podcasts get sponsored</h1>
      <p class="hero-lead">Brands find shows their customers love, with verified numbers and real sponsor history.</p>
      <div class="hero-actions">
        <%= ui_button "Find podcasts your customers love", new_brand_search_path, size: :lg %>
        <%= ui_button "Get your show sponsored", "#for-podcasters", variant: :secondary, size: :lg %>
      </div>
    </div>

    <div class="hero-wave">
      <%= episode_waveform %>
      <p class="hero-wave-label">Your midroll</p>
    </div>

    <%= render "pages/home/hero_card", sample: sample, matches: matches %>
  </div>
</section>

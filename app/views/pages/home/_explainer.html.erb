<%# locals: (video:) -%>
<%# How Midrolo works: the narrated tour, right after the hero, once an admin sets its YouTube video (AppSettings
    explainer_video_id; the page leaves this out while it's blank). Nothing loads from YouTube until the visitor
    presses play (components/_youtube), and then it plays in a large dialog: the poster is the video's own title card,
    in app/assets/images/explainer. sizes follows .explainer: the full width on a phone, the right two thirds of the
    72rem wrap from 64rem. %>
<section id="how-it-works" class="page-section" aria-labelledby="how-it-works-title">
  <div class="wrap explainer">
    <div>
      <h2 id="how-it-works-title" class="type-h2">How Midrolo works</h2>
      <p class="section-lead">A 2 minute tour for brands and podcasters.</p>
    </div>
    <%= render "components/youtube", video: video, title: "How Midrolo works", label: "Watch how it works",
                                     duration: "2 min", poster: "explainer/poster",
                                     sizes: "(min-width: 64rem) min(44rem, 66vw), calc(100vw - 2rem)" %>
  </div>
</section>

// GitHub Codespaces and the VS Code Dev Containers extension: Ruby, Postgres 16 and libvips in containers, nothing to
// install. The first start installs the gems and seeds the demo data (bin/setup --skip-server); every start then runs
// bin/dev in the background (its log is log/bin-dev.log), and port 3100 is Midrolo.
{
  "name": "Midrolo",
  "dockerComposeFile": "compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/midrolo",
  "shutdownAction": "stopCompose",
  "hostRequirements": { "cpus": 2, "memory": "4gb" },
  "forwardPorts": [3100],
  "portsAttributes": {
    "3100": { "label": "Midrolo", "onAutoForward": "notify" }
  },
  "postCreateCommand": "bin/setup --skip-server",
  "postStartCommand": "rm -f tmp/pids/server.pid; setsid nohup bin/dev > log/bin-dev.log 2>&1 < /dev/null &",
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] }
  }
}
